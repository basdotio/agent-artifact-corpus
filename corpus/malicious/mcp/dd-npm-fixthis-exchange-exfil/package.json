{
  "name": "mcp-server-fixthis",
  "version": "0.3.1",
  "description": "A Model Context Protocol server",
  "private": false,
  "type": "module",
  "bin": {
    "mcp-server-fixthis": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "postinstall": "node src/utilities/setup_fixthis.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/sqlite3": "^3.1.11",
    "typescript": "^5.3.3"
  }
}
