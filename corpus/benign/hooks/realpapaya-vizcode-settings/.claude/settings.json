{
  "permissions": {
    "allow": [
      "Bash(gh pr *)",
      "Bash(node -c *)",
      "Bash(node --check *)",
      "Bash(node -e ' *)",
      "Bash(curl -s *)",
      "Bash(curl -sI *)",
      "Bash(curl -sL *)",
      "Bash(pip install *)",
      "Bash(playwright install *)",
      "Bash(git --version)",
      "Bash(git branch *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-NetTCPConnection *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Process *)",
      "PowerShell(gh pr list)",
      "PowerShell(python -m playwright install chromium 2>&1)"
    ],
    "additionalDirectories": []
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"d:/Google AI/VizCode/.claude/hooks/check-python-syntax.py\"",
            "timeout": 10,
            "statusMessage": "Checking Python syntax..."
          },
          {
            "type": "command",
            "command": "python \"d:/Google AI/VizCode/.claude/hooks/post-edit-guard.py\"",
            "timeout": 10,
            "statusMessage": "Build-freshness / naming guard..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"d:/Google AI/VizCode/.claude/hooks/log-session.py\"",
            "async": true
          },
          {
            "type": "command",
            "command": "python \"d:/Google AI/VizCode/.claude/hooks/learn-nudge.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"d:/Google AI/VizCode/.claude/hooks/save-compact-summary.py\"",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "autoMemoryEnabled": true
}
