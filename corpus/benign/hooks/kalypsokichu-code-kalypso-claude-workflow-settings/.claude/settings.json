{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run build:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run test:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bun test:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(docker ps:*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(npm install:*)",
      "Bash(npm run *)",
      "Bash(bun install:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(brew install:*)",
      "Bash(docker *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -rf /)",
      "Bash(sudo rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(**/credentials*)",
      "Read(**/*.pem)"
    ]
  },
  "model": "opus",
  "env": {},
  "plansDirectory": "./reports",
  "enableAllProjectMcpServers": true,
  "respectGitignore": true,
  "hooks": {
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh PreToolUse", "async": true }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh PostToolUse", "async": true }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh PostToolUseFailure", "async": true }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh UserPromptSubmit", "async": true }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh Stop", "async": true }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh StopFailure", "async": true }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh Notification", "async": true }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh PermissionRequest", "async": true }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh SessionStart", "once": true, "async": true }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh SessionEnd", "once": true, "async": true }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/router.sh PreCompact", "async": true }] }
    ]
  }
}
