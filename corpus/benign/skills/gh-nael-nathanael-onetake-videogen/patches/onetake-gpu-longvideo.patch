+#!/usr/bin/env bash
+# 本地启动（Linux + NVIDIA GPU，无需 conda）：后端 :8000 + 前端 :5173
+set -euo pipefail
+cd "$(dirname "$0")"
+
+VENV=.venv
+SITE=$("$VENV/bin/python" -c 'import site; print(site.getsitepackages()[0])')
+# CTranslate2 (faster-whisper) 需要 pip 安装的 cuBLAS / cuDNN
+export LD_LIBRARY_PATH="$SITE/nvidia/cublas/lib:$SITE/nvidia/cudnn/lib:${LD_LIBRARY_PATH:-}"
+# 上传文件的临时缓冲写到磁盘，而不是 /tmp（可能是 tmpfs，占内存）
+mkdir -p storage/tmp
+export TMPDIR="$PWD/storage/tmp"
+
+"$VENV/bin/python" run.py &
+BACKEND_PID=$!
+trap 'kill $BACKEND_PID ${FRONTEND_PID:-} 2>/dev/null' EXIT INT TERM
+
+for _ in $(seq 30); do
+  curl -sf http://localhost:8000/health >/dev/null && break
+  sleep 1
+done
+
+(cd frontend && npm run dev -- --host 127.0.0.1) &
+FRONTEND_PID=$!
+
+echo "后端: http://localhost:8000/docs   前端: http://localhost:5173"
+wait
