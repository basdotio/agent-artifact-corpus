+async def save_upload_file(upload_file: UploadFile, destination: Path, max_size: int) -> int:
+    """分块异步保存上传的文件（不把整个文件读入内存），返回文件大小"""
+    size = 0
+    try:
+        async with aiofiles.open(destination, 'wb') as f:
