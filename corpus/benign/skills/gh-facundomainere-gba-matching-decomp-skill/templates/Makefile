# VERSION=metabee (default) or VERSION=rokusho: same C, version differences under #if VERSION_*
VERSION ?= metabee
ifeq ($(VERSION),metabee)
ROM     := medabots_ax.gba
BUILD   := build
VSUF    :=
else
ROM     := medabots_ax_$(VERSION).gba
BUILD   := build_$(VERSION)
VSUF    := _$(VERSION)
endif
VDEF    := -DVERSION_$(shell echo $(VERSION) | tr a-z A-Z)
PREFIX  := arm-none-eabi-
AS      := $(PREFIX)as
LD      := $(PREFIX)ld
OBJCOPY := $(PREFIX)objcopy
CC1     := tools/agbcc/bin/agbcc
CPP     := $(PREFIX)cpp
ASFLAGS := -mcpu=arm7tdmi -I include
CFLAGS  := -mthumb-interwork -Wimplicit -Wparentheses -O2 -fhex-asm -fprologue-bugfix

include objects.mk   # generated by tools/split.py, in link order (paths under build/)
OBJS := $(patsubst build/%,$(BUILD)/%,$(OBJS))
ifneq ($(VSUF),)
OBJS := $(patsubst %/asm/header.o,%/asm/header$(VSUF).o,$(patsubst %/data/data.o,%/data/data$(VSUF).o,$(OBJS)))
endif
LDSCRIPT := $(if $(VSUF),$(BUILD)/ld_script.ld,ld_script.ld)

.PHONY: all compare clean check-baserom progress
all: $(ROM)

check-baserom:
	@sha1sum --quiet -c baserom$(VSUF).sha1 || (echo "baserom$(VSUF).gba missing or wrong SHA1 (see README; other versions: tools/make_version.py)"; exit 1)

compare: $(ROM)
	sha1sum -c medabots_ax$(VSUF).sha1

$(ROM): $(BUILD)/$(ROM:.gba=.elf)
	$(OBJCOPY) -O binary $< $@

ifeq ($(VSUF),)
$(BUILD)/syms.ld: $(OBJS)
	python3 tools/syms.py $@ $(filter $(BUILD)/src/%,$(OBJS))
else
$(BUILD)/syms.ld: symbols$(VSUF).ld
	@mkdir -p $(BUILD)
	cp $< $@

$(BUILD)/ld_script.ld: ld_script.ld
	@mkdir -p $(BUILD)
	sed -e 's#build/#$(BUILD)/#g' -e 's#/asm/header.o#/asm/header$(VSUF).o#' -e 's#/data/data.o#/data/data$(VSUF).o#' $< > $@
endif

$(BUILD)/$(ROM:.gba=.elf): $(OBJS) $(BUILD)/lib/aliases$(VSUF).o $(LDSCRIPT) $(BUILD)/syms.ld
	$(LD) -T $(LDSCRIPT) -Map $(BUILD)/$(ROM:.gba=.map) -o $@ $(OBJS) $(BUILD)/lib/aliases$(VSUF).o

$(BUILD)/%.o: %.s asm/macros.inc | check-baserom
	@mkdir -p $(dir $@)
	$(AS) $(ASFLAGS) -o $@ $<

$(BUILD)/src/%.o: src/%.c | check-baserom
	@mkdir -p $(dir $@)
	$(CPP) $(VDEF) -nostdinc -I include -I tools/agbcc/include -MMD -MP -MF $(BUILD)/src/$*.d -MT $@ $< | $(CC1) $(CFLAGS) -o $(BUILD)/src/$*.s
	@printf '\t.align 2, 0\n' >> $(BUILD)/src/$*.s  # pad with 0000 like the original (209 of 212 cases)
	$(AS) $(ASFLAGS) -o $@ $(BUILD)/src/$*.s

-include $(wildcard $(BUILD)/src/*.d)  # header dependencies

progress:
	@python3 tools/progress.py

clean:
	rm -rf $(BUILD) $(ROM)
