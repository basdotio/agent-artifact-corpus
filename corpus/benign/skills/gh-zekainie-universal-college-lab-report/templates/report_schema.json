{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UniversalLabReportConfig",
  "type": "object",
  "required": [
    "course_name",
    "lab_name",
    "purposes",
    "principles",
    "process_part1",
    "process_part2",
    "raw_records",
    "questions"
  ],
  "properties": {
    "course_name": {
      "type": "string"
    },
    "lab_name": {
      "type": "string"
    },
    "instruments": {
      "type": "string"
    },
    "student_info": {
      "type": "object",
      "properties": {
        "university": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "student_id": {
          "type": "string"
        },
        "major": {
          "type": "string"
        },
        "class_num": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "group_num": {
          "type": "string"
        },
        "lab_name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    },
    "purposes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "desc"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          }
        }
      }
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "summary"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "prefix": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "process_part1": {
      "type": "object"
    },
    "process_part2": {
      "type": "object"
    },
    "raw_records": {
      "type": "array"
    },
    "questions": {
      "type": "array"
    },
    "summary": {
      "type": "string"
    }
  }
}
