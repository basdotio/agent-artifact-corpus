using XerahS.Uploaders;

namespace __NAMESPACE__;

public sealed class __UPLOADER_CLASS__ : FileUploader
{
    private readonly __CONFIG_MODEL_CLASS__ _config;
    private readonly string _apiToken;

    public __UPLOADER_CLASS__(__CONFIG_MODEL_CLASS__ config, string apiToken)
    {
        _config = config ?? throw new ArgumentNullException(nameof(config));
        _apiToken = apiToken ?? string.Empty;
    }

    public override UploadResult Upload(Stream stream, string fileName)
    {
        UploadResult result = new();

        if (string.IsNullOrWhiteSpace(_config.BaseUrl))
        {
            Errors.Add("Base URL is required.");
            return result;
        }

        if (string.IsNullOrWhiteSpace(_apiToken))
        {
            Errors.Add("API token is required.");
            return result;
        }

        Errors.Add("Replace the scaffolded upload logic in __UPLOADER_CLASS__.Upload with service-specific request code.");
        return result;
    }
}
