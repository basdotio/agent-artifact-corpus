#!/usr/bin/env bash
# The harness's own tests. No device, no network, no project: they must pass on a laptop with nothing
# plugged in. Run them after touching anything in harness/.
#
#   tests/run            every test
#   tests/run test_net   one file
set -euo pipefail
cd "$(dirname "$0")"
if [ $# -gt 0 ]; then exec python3 -m unittest "$@" -v; fi
exec python3 -m unittest discover -s . -p 'test_*.py' -v
