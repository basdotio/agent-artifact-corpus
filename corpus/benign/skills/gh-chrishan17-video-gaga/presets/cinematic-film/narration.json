  "segments": [
    { "id": "camera", "text": "今年春天，我在爸爸的旧相机里，发现了一卷没冲洗的胶卷。" },
    { "id": "counter", "text": "三十六张的胶卷，他只拍了三十五张。" },
    { "id": "darkroom", "text": "我把它冲了出来。" },
    { "id": "sea", "text": "第一张，是海，和他自己的影子。那年他二十六岁，跟我现在一样大。" },
    { "id": "bike", "text": "然后是一辆自行车，" },
    { "id": "window", "text": "一扇亮着灯的窗。窗里的那个人，后来成了我妈妈。" },
    { "id": "born", "text": "第三十五张，是我出生那天，医院窗外的天。" },
    { "id": "blank", "text": "最后一格，空了二十六年。正好是我的年纪。" },
    { "id": "grow", "text": "从那天起，他不再看海了。他看着我长大。" },
    { "id": "return", "text": "今年五月，我带他回到了那片海。" },
    { "id": "dad", "text": "我都忘了，我以前还会拍照。", "voice": "zh-CN-YunjianNeural", "rate": "-14%", "pitch": "-6Hz" },
    { "id": "sheet", "text": "三十六张，终于拍完了。" }
  ]
}
