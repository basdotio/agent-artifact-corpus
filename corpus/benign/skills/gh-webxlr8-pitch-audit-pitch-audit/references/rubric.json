{
  "_doc": "Scoring rubric used by scripts/score.py. Edit weights, thresholds and deductions here. Weights must sum to 100. Every category starts at 100 and loses points for each failed check (floor 0). See audit-rubric.md for the reasoning.",
  "version": "1.0-draft",
  "grade_bands": {
    "healthy": 80,
    "needs_work": 60
  },
  "categories": {
    "performance": {
      "label": "Performance",
      "weight": 20
    },
    "seo": {
      "label": "SEO Foundations",
      "weight": 15
    },
    "mobile_ux": {
      "label": "Mobile & UX",
      "weight": 15
    },
    "trust": {
      "label": "Trust & Security",
      "weight": 10
    },
    "conversion": {
      "label": "Conversion",
      "weight": 15
    },
    "social": {
      "label": "Social Visibility",
      "weight": 10
    },
    "geo": {
      "label": "AI Search (GEO)",
      "weight": 5
    },
    "ops": {
      "label": "Ops Maturity",
      "weight": 10
    }
  },
  "thresholds": {
    "lcp_ms": {
      "warn": 2500,
      "crit": 4000
    },
    "cls": {
      "warn": 0.1,
      "crit": 0.25
    },
    "tbt_ms": {
      "warn": 200,
      "crit": 600
    },
    "ttfb_ms": {
      "warn": 800,
      "crit": 1800
    },
    "page_bytes": {
      "warn": 3000000,
      "crit": 6000000
    },
    "title_len": {
      "min": 30,
      "max": 65
    },
    "meta_desc_len": {
      "min": 70,
      "max": 160
    },
    "alt_missing_pct": {
      "warn": 20
    },
    "ssl_days_left": {
      "warn": 30
    },
    "social_inactive_days": 30
  },
  "deductions": {
    "performance": {
      "_base": "0.7 * lighthouse mobile performance + 0.3 * desktop performance. If Lighthouse missing: start 100, apply ttfb/page_bytes deductions only.",
      "ttfb_warn": 5,
      "ttfb_crit": 25,
      "page_bytes_warn": 5,
      "page_bytes_crit": 15
    },
    "seo": {
      "title_missing": 25,
      "title_length": 8,
      "meta_desc_missing": 15,
      "meta_desc_length": 5,
      "h1_missing": 15,
      "h1_multiple": 5,
      "canonical_missing": 8,
      "sitemap_missing": 12,
      "robots_missing": 5,
      "robots_blocks_all": 40,
      "noindex": 40,
      "schema_missing": 12,
      "alt_missing": 8,
      "lang_missing": 5,
      "lighthouse_seo_below_90_per_point": 0.5
    },
    "mobile_ux": {
      "viewport_missing": 40,
      "horizontal_overflow": 20,
      "lighthouse_a11y_below_90_per_point": 0.8,
      "mobile_lcp_crit": 10,
      "console_errors": 5,
      "broken_links_each": 4,
      "broken_links_max": 20
    },
    "trust": {
      "no_https": 50,
      "no_https_redirect": 15,
      "ssl_expiring": 15,
      "hsts_missing": 5,
      "security_header_missing_each": 3,
      "security_header_max": 9,
      "mixed_content": 15,
      "privacy_missing": 10,
      "social_proof_missing": 10,
      "contact_missing": 10,
      "lighthouse_best_practices_below_80": 10,
      "apex_cert_mismatch": 30
    },
    "conversion": {
      "no_cta_above_fold": 20,
      "no_click_to_call": 10,
      "no_whatsapp_or_chat": 10,
      "no_form_or_booking": 10,
      "no_analytics": 20,
      "no_ad_pixel": 10,
      "no_online_transaction_when_expected": 15
    },
    "social": {
      "_note": "manual.social is filled by Claude from public profiles. Unknown values are NOT penalised beyond link checks; they show as 'not verified'.",
      "no_profiles_linked": 40,
      "one_profile_linked": 20,
      "og_image_missing": 10,
      "og_title_missing": 5,
      "inactive_platform_each": 15,
      "inactive_max": 30,
      "low_audience": 15
    },
    "geo": {
      "llms_txt_missing": 15,
      "schema_missing": 20,
      "faq_missing": 15,
      "absent_in_answers": 40,
      "no_google_business_profile": 10,
      "ai_search_bots_blocked": 35
    },
    "ops": {
      "_note": "Signals come from audit.ops_signals plus manual.ops_signals that Claude adds from research.",
      "whatsapp_only_ordering": 20,
      "google_forms": 15,
      "pdf_catalog": 10,
      "call_to_order_no_online_flow": 15,
      "no_customer_portal_when_expected": 15,
      "legacy_stack": 10,
      "manual_signal_each": 10,
      "manual_signal_max": 30
    }
  },
  "lead_score": {
    "_doc": "lead_score = opportunity_weight * (100 - overall) + fit_weight * fit. fit comes from pitch-profile/mapping.yaml fit_rules (or manual.fit).",
    "opportunity_weight": 0.6,
    "fit_weight": 0.4,
    "fit_defaults": {
      "generic": 50
    }
  }
}