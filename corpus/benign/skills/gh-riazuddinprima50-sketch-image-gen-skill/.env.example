# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env`.
#
# Any OpenAI-compatible image API works (base URL must expose
# /images/generations and optionally /images/edits).

IMAGE_API_KEY=sk-your-key-here
IMAGE_API_BASE=https://your-relay.example/v1
IMAGE_MODEL=gpt-image-2.5

# Optional: default output directory (defaults to ./generated-images)
# IMAGE_OUT_DIR=generated-images
