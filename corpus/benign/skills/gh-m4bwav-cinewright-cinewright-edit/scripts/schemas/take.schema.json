{
  "$comment": "copied from shared/schemas/take.schema.json sha256:066057c4ce1f32b65f75841c2a343ce13e7034a390cc1c4585bd77a2b92718b3; edit the source",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Take record",
  "description": "One generated take of one card, the same shape for every model (takes/<card>-<n>.json).",
  "type": "object",
  "required": [
    "card",
    "take",
    "model",
    "date",
    "verdict"
  ],
  "additionalProperties": false,
  "properties": {
    "card": {
      "type": "string"
    },
    "take": {
      "type": "integer",
      "minimum": 1
    },
    "model": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "params": {
      "type": "object"
    },
    "file": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pending",
        "pass",
        "fail",
        "keep-fix-in-edit"
      ]
    },
    "fix_code": {
      "type": "string",
      "description": "Failure taxonomy code (S2)."
    },
    "change_from_previous": {
      "type": "string",
      "description": "The one thing changed from the previous take."
    },
    "observed_end_state": {
      "type": "string",
      "description": "What the last frame actually shows, for the next card's start."
    },
    "notes": {
      "type": "string"
    }
  }
}
