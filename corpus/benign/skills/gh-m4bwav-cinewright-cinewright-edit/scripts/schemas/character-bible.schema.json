{
  "$comment": "copied from shared/schemas/character-bible.schema.json sha256:b408a8cf2325bb86b47a6a8e964139047b39efe351c1115c638f9a053313b507; edit the source",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character bible",
  "description": "bibles/characters.json: one identity string per character, copied verbatim into every card and prompt, plus wardrobe by scene.",
  "type": "object",
  "required": [
    "characters"
  ],
  "additionalProperties": false,
  "properties": {
    "pronounce": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "How names and invented words are said: the word as written -> the spelling the voice model reads. Used inside spoken lines only; the name stays as written everywhere else."
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "identity",
          "wardrobe"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "identity": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300,
            "description": "Age, build, face, hair, one distinctive mark. No wardrobe."
          },
          "voice": {
            "type": "string"
          },
          "wardrobe": {
            "type": "object",
            "required": [
              "default"
            ],
            "additionalProperties": {
              "type": "string"
            },
            "description": "default plus optional overrides keyed by scene id."
          },
          "props": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Turnaround sheet or reference image ids."
          }
        }
      }
    }
  }
}
