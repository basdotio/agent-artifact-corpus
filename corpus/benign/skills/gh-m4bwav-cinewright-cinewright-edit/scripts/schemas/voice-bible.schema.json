{
  "$comment": "copied from shared/schemas/voice-bible.schema.json sha256:db9570e9dbc23c1dc20892ae11c4cc5ec0e5f18933b6fa5b2150a6aaaa664602; edit the source",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice bible",
  "description": "bibles/voices.json (optional): one locked voice per speaking character. The short voice string stays in characters.json and is copied into prompts; this file holds the voice sheet, how the voice was made, its reference clips and its rights.",
  "type": "object",
  "required": [
    "voices"
  ],
  "additionalProperties": false,
  "definitions": {
    "ref": {
      "type": "object",
      "required": [
        "file",
        "text",
        "emotion",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "path from the project root, a clean mono WAV"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "exactly what is said in the clip"
        },
        "emotion": {
          "type": "string",
          "description": "neutral first; then one clip per emotion the script needs"
        },
        "source": {
          "enum": [
            "designed",
            "take",
            "recorded",
            "library",
            "converted"
          ]
        },
        "from": {
          "type": "string",
          "description": "the take, file or generation it was cut from"
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "voices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "character",
          "sheet",
          "refs",
          "rights"
        ],
        "additionalProperties": false,
        "properties": {
          "character": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "id in characters.json"
          },
          "sheet": {
            "type": "object",
            "required": [
              "age",
              "gender",
              "pitch",
              "pace",
              "timbre"
            ],
            "additionalProperties": {
              "type": "string"
            },
            "properties": {
              "age": {
                "type": "string"
              },
              "gender": {
                "type": "string"
              },
              "pitch": {
                "type": "string"
              },
              "pace": {
                "type": "string"
              },
              "timbre": {
                "type": "string"
              },
              "accent": {
                "type": "string"
              },
              "energy": {
                "type": "string"
              },
              "attitude": {
                "type": "string"
              },
              "quirks": {
                "type": "string"
              },
              "reference_point": {
                "type": "string",
                "description": "a known voice it sits near, for people only; never put a real person's name in a prompt"
              }
            }
          },
          "design_prompt": {
            "type": "string",
            "maxLength": 1000,
            "description": "the text a voice design model was given"
          },
          "engine": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "voice_id": {
                "type": "string"
              },
              "seed": {
                "type": "integer"
              },
              "settings": {
                "type": "object"
              }
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ref"
            }
          },
          "tolerance_st": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 6,
            "description": "how far a line's median pitch may sit from the reference, semitones (default 2)"
          },
          "rights": {
            "type": "string",
            "minLength": 10,
            "description": "whose voice this is and the permission: 'original designed voice', or 'recorded by <actor> with written consent, <date>'"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
