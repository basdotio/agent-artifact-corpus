{
  "$comment": "copied from shared/schemas/location-bible.schema.json sha256:a15dc1d259fe2cf3d89bce0f412fa29dbf82d0a833b1e40481c8fc511a97b2f0; edit the source",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Location bible",
  "description": "bibles/locations.json: one description string per location, copied verbatim into prompts.",
  "type": "object",
  "required": [
    "locations"
  ],
  "additionalProperties": false,
  "properties": {
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "int_ext",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "int_ext": {
            "enum": [
              "INT",
              "EXT",
              "INT/EXT"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
          },
          "props": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "walls": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9-]+$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 20,
              "maxLength": 300
            },
            "description": "Optional: what each wall or view shows, keyed by a name such as north or toward-desk. A card's camera.faces picks one and compile adds it after the description, which then holds only what every angle shares."
          }
        }
      }
    }
  }
}
