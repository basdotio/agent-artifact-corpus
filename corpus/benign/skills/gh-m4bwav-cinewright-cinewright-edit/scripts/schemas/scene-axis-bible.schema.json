{
  "$comment": "copied from shared/schemas/scene-axis-bible.schema.json sha256:8c47eae1339216b0d3fe0000ce147e3b0ecb384974c24d8318d49b3cbac240c8; edit the source",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene axis bible",
  "description": "bibles/scenes.json: per scene, the location, time, sun, the axis (line of action), which side the camera stays on, and where each character sits and travels as seen from side A.",
  "type": "object",
  "required": [
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "location",
          "time_of_day",
          "axis"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "heading": {
            "type": "string",
            "description": "Screenplay slugline, e.g. INT. KITCHEN - NIGHT."
          },
          "location": {
            "type": "string"
          },
          "time_of_day": {
            "enum": [
              "dawn",
              "morning",
              "day",
              "golden-hour",
              "dusk",
              "night"
            ]
          },
          "sun": {
            "type": "string",
            "description": "World direction and height of the sun or main source, verbatim."
          },
          "props": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "axis": {
            "type": "object",
            "required": [
              "line",
              "camera_side"
            ],
            "additionalProperties": false,
            "properties": {
              "line": {
                "type": "string",
                "description": "What the axis runs through: two characters, or a line of travel."
              },
              "camera_side": {
                "enum": [
                  "A"
                ],
                "description": "Cameras stay on side A; side B is across the line."
              },
              "positions": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "frame-left",
                    "center",
                    "frame-right"
                  ]
                }
              },
              "travel": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "left-to-right",
                    "right-to-left",
                    "toward-camera",
                    "away-from-camera",
                    "none"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
