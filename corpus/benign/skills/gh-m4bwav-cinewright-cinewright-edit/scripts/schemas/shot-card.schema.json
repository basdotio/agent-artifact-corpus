{
  "$comment": "copied from shared/schemas/shot-card.schema.json sha256:f5b6252020fc5450f5b4082b6fbb6efd6f8b0aae7937d373dd7a1c8cb8bb381a; edit the source",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shot card",
  "description": "One shot, generator-neutral. Fields follow the shot list (slate, size, angle, move, lens, action, dialogue, duration) and the script supervisor's notes (camera side, screen direction, eyelines, wardrobe, props in hand, start and end state).",
  "type": "object",
  "required": [
    "id",
    "scene",
    "order",
    "duration_s",
    "camera",
    "cast",
    "action"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]+[A-Z]{0,2}$",
      "description": "Slate: scene number plus shot letter, e.g. 1A."
    },
    "scene": {
      "type": "string",
      "description": "Scene id in scenes.json."
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "Position in the cut."
    },
    "duration_s": {
      "type": "number",
      "minimum": 3,
      "maximum": 8
    },
    "beat": {
      "type": "string",
      "maxLength": 200,
      "description": "What the shot tells the audience."
    },
    "camera": {
      "type": "object",
      "required": [
        "size",
        "angle",
        "move",
        "side"
      ],
      "additionalProperties": false,
      "properties": {
        "size": {
          "enum": [
            "EWS",
            "WS",
            "FS",
            "MWS",
            "MS",
            "MCU",
            "CU",
            "ECU"
          ]
        },
        "angle": {
          "enum": [
            "eye-level",
            "high",
            "low",
            "overhead",
            "ground",
            "dutch"
          ]
        },
        "azimuth_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "description": "Horizontal position on the camera side: 0 and 180 lie on the axis, 90 is square to it."
        },
        "move": {
          "enum": [
            "static",
            "pan-left",
            "pan-right",
            "tilt-up",
            "tilt-down",
            "dolly-in",
            "dolly-out",
            "truck-left",
            "truck-right",
            "track",
            "crane-up",
            "crane-down",
            "handheld",
            "zoom-in",
            "zoom-out"
          ]
        },
        "lens_mm": {
          "type": "number",
          "minimum": 8,
          "maximum": 600
        },
        "faces": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Which wall or view of the location the camera looks at: a key of the location's walls."
        },
        "side": {
          "enum": [
            "A",
            "B"
          ],
          "description": "Side of the scene axis the camera stands on."
        },
        "crosses_axis": {
          "type": "boolean"
        },
        "cross_reason": {
          "type": "string"
        },
        "framing": {
          "enum": [
            "single",
            "two-shot",
            "ots",
            "insert",
            "pov",
            "group"
          ]
        }
      }
    },
    "subject": {
      "type": "string",
      "maxLength": 160,
      "description": "Non-cast subject, e.g. a prop for an insert."
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "identity"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "identity": {
            "type": "string",
            "description": "Verbatim copy of the character bible's identity string."
          },
          "wardrobe": {
            "type": "string",
            "description": "Verbatim copy of the bible's wardrobe for this scene."
          },
          "position": {
            "enum": [
              "frame-left",
              "center",
              "frame-right"
            ]
          },
          "looks_at": {
            "type": "string",
            "description": "Character id or object the eyes are on."
          },
          "eyeline": {
            "enum": [
              "frame-left",
              "frame-right",
              "up",
              "down",
              "camera"
            ]
          },
          "travel": {
            "enum": [
              "left-to-right",
              "right-to-left",
              "toward-camera",
              "away-from-camera",
              "none"
            ]
          },
          "holding": {
            "type": [
              "string",
              "null"
            ],
            "description": "Prop in hand at the start of the shot."
          },
          "holding_end": {
            "type": [
              "string",
              "null"
            ],
            "description": "Prop in hand at the end, when it changes."
          },
          "holding_state": {
            "type": "string",
            "description": "One of the held prop's states in props.json; its description and refs replace the prop's."
          }
        }
      }
    },
    "props": {
      "type": "array",
      "description": "Props the shot features that nobody holds (a parked car, a tank, a cart), compiled with the prop bible's description and refs.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "A props.json name."
          },
          "state": {
            "type": "string",
            "description": "One of that prop's states."
          },
          "where": {
            "type": "string",
            "description": "Where it is in frame, e.g. in the foreground, frame-left."
          }
        }
      }
    },
    "action": {
      "type": "string",
      "minLength": 5,
      "maxLength": 240,
      "description": "One action, present tense."
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "character",
          "line"
        ],
        "additionalProperties": false,
        "properties": {
          "character": {
            "type": "string"
          },
          "line": {
            "type": "string",
            "maxLength": 200
          },
          "tone": {
            "type": "string",
            "description": "Delivery, pasted after 'says': an adverb or phrase ('quietly', 'under his breath'), never a verb ('mutters')."
          }
        }
      }
    },
    "sound": {
      "type": "string",
      "maxLength": 200
    },
    "music": {
      "type": "string",
      "maxLength": 240,
      "description": "Score under this card (non-diegetic): style, instruments, tempo, and where it starts, stops or hits. Models with a music slot get it there; other audio models get it after the sound."
    },
    "time_of_day": {
      "enum": [
        "dawn",
        "morning",
        "day",
        "golden-hour",
        "dusk",
        "night"
      ]
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sun": {
          "type": "string"
        },
        "key_side": {
          "enum": [
            "frame-left",
            "frame-right",
            "top",
            "back"
          ]
        },
        "quality": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "motivation": {
          "type": "string"
        }
      }
    },
    "start_state": {
      "type": "string",
      "maxLength": 240
    },
    "end_state": {
      "type": "string",
      "maxLength": 240
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reference image ids from the bibles, or file paths."
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    }
  }
}
