# AUTHOR: Erik Schultes (ORCID: 0000-0001-8888-635X)
# SESSION: Making MAC FAIR/npfdo Chat B2  DATE: 2026-09-28
# URL: https://claude.ai/chat/06e46b23-6173-46d6-a59e-5b7fb629498f  CREATED_AT: P04/R04 (revised P12/R12)
# DESCRIPTION: Non-normative np-FDO record skeleton. Replace every <...> and drop unused optional
#   blocks. Both temp prefixes end in "/". This is a guide, not a file to sign as-is.

@prefix this: <http://purl.org/nanopub/temp/npfdo-rec/> .
@prefix sub: <http://purl.org/nanopub/temp/npfdo-rec/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npfdo: <https://w3id.org/npfdo/terms/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix fdof: <https://w3id.org/fdof/ontology#> .
@prefix faia_ont: <https://w3id.org/faia-framework/faia_ont/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix orcid: <https://orcid.org/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  # C1 type (from the v0.1 choice list), C2 label with language tag. Referent is sub:referent when
  # introduced, or the full external IRI when describing an existing identifier.
  sub:referent a <TYPE-IRI> ;
    rdfs:label "<LABEL>"@<LANG> ;
    dct:description "<DESCRIPTION>"@<LANG> ;   # optional (slot list C)
    dct:creator orcid:<CREATOR-ORCID> ;        # optional, repeatable (slot list C)
    dct:isPartOf <TARGET-IRI> .                # optional qualified reference (slot list D)

  # Materialisation cluster (slot list B), 0..n. Omit the whole block if there is no file.
  sub:file fdof:materializes sub:referent ;
    dcat:accessURL <ACCESS-URL> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:downloadURL <DOWNLOAD-URL> ;
    dcat:mediaType <http://www.iana.org/assignments/media-types/<TYPE>/<SUBTYPE>> ;
    dcat:byteSize "<N>"^^xsd:nonNegativeInteger ;
    dct:issued "<YYYY-MM-DD>"^^xsd:date ;
    spdx:checksum sub:checksum .
  sub:checksum a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "<SHA-256-OF-BYTES-AT-DOWNLOAD-URL>" .

  # FAIA about the referent (optional). Flag alone is the minimum.
  # sub:referent faia_ont:faiaFlag "https://w3id.org/faia-framework/faia_vocab/AAC"^^xsd:anyURI .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:<USER-ORCID> .

  # FAIA about the activity that produced the description (optional):
  # sub:assertion prov:wasGeneratedBy sub:activity .
  # sub:activity a prov:Activity ;
  #   faia_ont:faiaFlag "https://w3id.org/faia-framework/faia_vocab/AAC"^^xsd:anyURI ;
  #   faia_ont:activityCode "https://w3id.org/faia-framework/faia_vocab/Contribution"^^xsd:anyURI ;
  #   faia_ont:systemAttribution "<SYSTEM>" ;
  #   faia_ont:systemVersion "<VERSION>" .
}

sub:pubinfo {
  this: npx:hasNanopubType npfdo:FDORecord ;
    npx:introduces sub:referent ;                 # or: npx:describes <EXISTING-IRI>
    dct:conformsTo <https://w3id.org/np/RAYTT7oW0dbPdx3PqIA1m9XBLRGYVqmAhzLY7vLTMG1GI> ;
    dct:created "<YYYY-MM-DDThh:mm:ssZ>"^^xsd:dateTime ;
    dct:creator orcid:<USER-ORCID> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;   # elicited; CC BY 4.0 proposed
    # npx:supersedes <OLD-TRUSTY-URI> ;           # only on same-key supersession
    nt:wasCreatedFromTemplate <https://w3id.org/np/RA5OrG1-PCAa3Z4kTLKTxq8lhgNAsopAtQM5h0-xj3MSA/template> ;
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RAQV2LjRzG8BQ8wXb6Kbyytc8vVAUeS4pFdoOkG2WA_yI/template>, <https://w3id.org/np/RA-N4_kFxcruvBTlo1yJv29E4SLOXsx5KO_th69PprMrA>, <https://w3id.org/np/RALmzqHlrRfeTD8ESZdKFyDNYY6eFuyQ8GAe_4N5eVytc>, <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8> .

  # FAIA about the record itself (optional):
  # this: faia_ont:faiaFlag "https://w3id.org/faia-framework/faia_vocab/AAC"^^xsd:anyURI .
}
