{
  "name": "Demo flow",
  "nodes": [
    {
      "id": "1",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "2",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        200,
        0
      ],
      "parameters": {
        "url": "https://api.example.com/items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.API_TOKEN }}"
            }
          ]
        },
        "tokenUrl": "https://auth.example.com/token"
      }
    },
    {
      "id": "3",
      "name": "Mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "toEmail": "user@example.com",
        "text": "Hello {{ $json.name }}, version 2.4.1"
      }
    }
  ],
  "connections": {
    "Manual": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}