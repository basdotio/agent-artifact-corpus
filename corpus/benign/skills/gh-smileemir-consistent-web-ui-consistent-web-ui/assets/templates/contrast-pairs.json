    {"fg": "--color-on-brand", "bg": "--color-brand", "use": "primary button label"},
    {"fg": "--color-on-brand", "bg": "--color-brand-hover", "use": "primary button hover"},
    {"fg": "--color-on-accent", "bg": "--color-accent", "use": "accent label"},
