{
  "name": "tiktok-record-organizer",
  "version": "1.0.0",
  "description": "实时获取TikTok平台的记录及数据整理为结构化的成果：作品描述、发布时间、点赞数、评论数、分享数、收藏数、评论内容等互动数据，可根据数据获取时间进行横向对比分析，帮助用户记录TikTok社媒平台作品的表现，便于后续分析和决策。",
  "keywords": [
    "tiktok",
    "search",
    "keyword",
    "content-analysis",
    "competitor-analysis"
  ],
  "author": "um-why",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=16.14.0"
  },
  "scripts": {
    "search": "node scripts/tiktok/search-cli.js",
    "post": "node scripts/tiktok/post-cli.js",
    "comment": "node scripts/tiktok/comment-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/um-why/tiktok-skill.git"
  }
}