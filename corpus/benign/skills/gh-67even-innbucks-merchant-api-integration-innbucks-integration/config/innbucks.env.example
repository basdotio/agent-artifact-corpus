# .env - never commit this file
INNBUCKS_BASE_URL=https://<test-base-url-from-innbucks>
INNBUCKS_API_KEY=your-api-key
INNBUCKS_USERNAME=your-username
INNBUCKS_PASSWORD=your-password

# test or production: picks the deep-link scheme (section 5.3) and guards money-moving calls
INNBUCKS_ENV=test

# seconds to keep a token before logging in again (15-minute tokens -> 840)
INNBUCKS_TOKEN_TTL=840
