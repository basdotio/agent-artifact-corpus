{
  "name": "motion-director-film",
  "private": true,
  "description": "A motion-director film: a deterministic HTML/JS composition rendered frame by frame with real motion blur.",
  "scripts": {
    "serve": "node tools/server.js 5177",
    "stills": "node tools/render.js --stills",
    "preview": "node tools/render.js --scale 0.5 --sub 1 --workers 4 --out renders/preview.mkv",
    "render": "node tools/render.js --workers 4 --out renders/master.mkv",
    "cues": "node tools/probe.js 0 \"window.getCues()\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.34.0"
  }
}
