{
  "name": "claude-skill-style-guide",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test core/*.test.ts scripts/*.test.ts app/*.test.ts lib/*.test.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
