{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    // node で .ts を直接実行する (型ストリッピング) ための設定。
    // import に拡張子 .ts を書き、型だけの import は import type にし、enum など実行時コードを生む構文を禁じる
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["core/**/*.ts", "app/**/*.ts", "lib/**/*.ts", "scripts/**/*.ts"]
}
