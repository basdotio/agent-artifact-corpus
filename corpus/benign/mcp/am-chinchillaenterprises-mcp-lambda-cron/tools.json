{
  "package": "@chinchillaenterprises/mcp-lambda-cron",
  "tools": [
    {
      "name": "list_accounts",
      "description": "List all configured AWS accounts",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "add_account",
      "description": "Add a new AWS account configuration",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Friendly name for this account"
          },
          "accessKeyId": {
            "type": "string",
            "description": "AWS Access Key ID"
          },
          "secretAccessKey": {
            "type": "string",
            "description": "AWS Secret Access Key"
          },
          "sessionToken": {
            "type": "string",
            "description": "AWS Session Token (optional)"
          },
          "region": {
            "type": "string",
            "description": "AWS Region (e.g., us-east-1)"
          }
        },
        "required": [
          "name",
          "accessKeyId",
          "secretAccessKey",
          "region"
        ]
      }
    },
    {
      "name": "switch_account",
      "description": "Switch to a different AWS account",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Account ID to switch to"
          }
        },
        "required": [
          "accountId"
        ]
      }
    },
    {
      "name": "remove_account",
      "description": "Remove an AWS account configuration",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Account ID to remove"
          }
        },
        "required": [
          "accountId"
        ]
      }
    },
    {
      "name": "get_active_account",
      "description": "Get the currently active AWS account",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "set_default_account",
      "description": "Set an account as the default for new sessions",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Account ID to set as default"
          }
        },
        "required": [
          "accountId"
        ]
      }
    },
    {
      "name": "create_cron_rule",
      "description": "Create a new cron job rule for a Lambda function using EventBridge",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ruleName": {
            "type": "string",
            "description": "Name for the cron rule"
          },
          "cronExpression": {
            "type": "string",
            "description": "Cron expression (e.g., \"0 12 * * ? *\" for daily at noon UTC)"
          },
          "functionName": {
            "type": "string",
            "description": "Lambda function name or ARN"
          },
          "description": {
            "type": "string",
            "description": "Description of the rule"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the rule should be enabled (default: true)"
          },
          "input": {
            "type": "string",
            "description": "JSON input to pass to the Lambda function"
          }
        },
        "required": [
          "ruleName",
          "cronExpression",
          "functionName"
        ]
      }
    },
    {
      "name": "create_rate_rule",
      "description": "Create a new rate-based schedule rule for a Lambda function",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ruleName": {
            "type": "string",
            "description": "Name for the rate rule"
          },
          "rateExpression": {
            "type": "string",
            "description": "Rate expression (e.g., \"5 minutes\", \"1 hour\", \"7 days\")"
          },
          "functionName": {
            "type": "string",
            "description": "Lambda function name or ARN"
          },
          "description": {
            "type": "string",
            "description": "Description of the rule"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the rule should be enabled (default: true)"
          },
          "input": {
            "type": "string",
            "description": "JSON input to pass to the Lambda function"
          }
        },
        "required": [
          "ruleName",
          "rateExpression",
          "functionName"
        ]
      }
    },
    {
      "name": "delete_rule",
      "description": "Delete a cron/rate rule and remove Lambda permissions",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ruleName": {
            "type": "string",
            "description": "Name of the rule to delete"
          },
          "functionName": {
            "type": "string",
            "description": "Lambda function name (for cleaning up permissions)"
          }
        },
        "required": [
          "ruleName"
        ]
      }
    },
    {
      "name": "list_rules",
      "description": "List all EventBridge rules, optionally filtered by prefix",
      "inputSchema": {
        "type": "object",
        "properties": {
          "namePrefix": {
            "type": "string",
            "description": "Filter rules by name prefix"
          },
          "targetFunction": {
            "type": "string",
            "description": "Filter rules targeting a specific Lambda function"
          }
        }
      }
    },
    {
      "name": "get_rule_details",
      "description": "Get detailed information about a specific rule",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ruleName": {
            "type": "string",
            "description": "Name of the rule"
          }
        },
        "required": [
          "ruleName"
        ]
      }
    },
    {
      "name": "enable_rule",
      "description": "Enable a disabled rule",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ruleName": {
            "type": "string",
            "description": "Name of the rule to enable"
          }
        },
        "required": [
          "ruleName"
        ]
      }
    },
    {
      "name": "disable_rule",
      "description": "Disable an active rule",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ruleName": {
            "type": "string",
            "description": "Name of the rule to disable"
          }
        },
        "required": [
          "ruleName"
        ]
      }
    },
    {
      "name": "update_rule_schedule",
      "description": "Update the schedule expression of an existing rule",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ruleName": {
            "type": "string",
            "description": "Name of the rule to update"
          },
          "scheduleExpression": {
            "type": "string",
            "description": "New schedule expression (cron or rate)"
          }
        },
        "required": [
          "ruleName",
          "scheduleExpression"
        ]
      }
    },
    {
      "name": "list_lambda_functions",
      "description": "List available Lambda functions in the account",
      "inputSchema": {
        "type": "object",
        "properties": {
          "functionNamePrefix": {
            "type": "string",
            "description": "Filter functions by name prefix"
          }
        }
      }
    },
    {
      "name": "create_advanced_schedule",
      "description": "Create an advanced schedule using EventBridge Scheduler (supports time zones, flexible windows)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scheduleName": {
            "type": "string",
            "description": "Name for the schedule"
          },
          "scheduleExpression": {
            "type": "string",
            "description": "Schedule expression (cron, rate, or at)"
          },
          "functionArn": {
            "type": "string",
            "description": "Lambda function ARN"
          },
          "timezone": {
            "type": "string",
            "description": "Timezone (e.g., \"America/New_York\")"
          },
          "flexibleTimeWindow": {
            "type": "number",
            "description": "Flexible time window in minutes (0-1440)"
          },
          "startDate": {
            "type": "string",
            "description": "Start date (ISO 8601 format)"
          },
          "endDate": {
            "type": "string",
            "description": "End date (ISO 8601 format)"
          },
          "input": {
            "type": "string",
            "description": "JSON input to pass to the Lambda function"
          }
        },
        "required": [
          "scheduleName",
          "scheduleExpression",
          "functionArn"
        ]
      }
    }
  ]
}