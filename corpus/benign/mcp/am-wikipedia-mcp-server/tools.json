{
  "package": "wikipedia-mcp-server",
  "tools": [
    {
      "name": "search_wikipedia",
      "description": "Search Wikipedia articles by keyword（キーワードでWikipedia記事を検索する）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search keyword"
          },
          "lang": {
            "type": "string",
            "default": "ja",
            "description": "Language code (ja, en, etc.)"
          },
          "limit": {
            "type": "number",
            "default": 5,
            "description": "Number of search results"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_wikipedia_article",
      "description": "Get detailed information about a Wikipedia article（Wikipedia記事の詳細情報を取得する）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Article title"
          },
          "lang": {
            "type": "string",
            "default": "ja",
            "description": "Language code (ja, en, etc.)"
          },
          "include_content": {
            "type": "boolean",
            "default": false,
            "description": "Include article content (wikitext)"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_random_wikipedia",
      "description": "Get random Wikipedia articles（ランダムなWikipedia記事を取得する）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "default": "ja",
            "description": "Language code (ja, en, etc.)"
          },
          "count": {
            "type": "number",
            "default": 5,
            "description": "Number of random articles to get"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}