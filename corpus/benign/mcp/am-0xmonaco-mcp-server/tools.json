{
  "package": "@0xmonaco/mcp-server",
  "tools": [
    {
      "name": "search_docs",
      "description": "Search the Monaco documentation for information about the protocol, SDK, trading, and development guides.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_trading_pairs",
      "description": "Get a paginated list of trading pairs available on Monaco. Returns pair IDs, symbols, base/quote tokens, and status.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "page": {
            "description": "Page number (starts from 1)",
            "type": "number"
          },
          "limit": {
            "description": "Number of items per page (max 100)",
            "type": "number"
          },
          "market_type": {
            "description": "Filter by market type",
            "type": "string"
          },
          "base_token": {
            "description": "Filter by base token",
            "type": "string"
          },
          "quote_token": {
            "description": "Filter by quote token",
            "type": "string"
          },
          "is_active": {
            "description": "Filter by active status",
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "get_trading_pair_by_symbol",
      "description": "Look up a specific trading pair by its symbol (e.g. 'BTC/USDC'). Returns the pair's full details including its UUID.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Trading pair symbol (e.g. 'BTC/USDC')"
          }
        },
        "required": [
          "symbol"
        ]
      }
    },
    {
      "name": "get_candlesticks",
      "description": "Get OHLCV candlestick data for a trading pair. Useful for charting and price analysis.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "trading_pair_id": {
            "type": "string",
            "description": "Trading pair UUID"
          },
          "interval": {
            "type": "string",
            "enum": [
              "1m",
              "5m",
              "15m",
              "1h",
              "4h",
              "1d"
            ],
            "description": "Candlestick interval"
          },
          "start_time": {
            "description": "Start time as Unix timestamp (seconds)",
            "type": "number"
          },
          "end_time": {
            "description": "End time as Unix timestamp (seconds)",
            "type": "number"
          },
          "limit": {
            "description": "Max number of candlesticks to return",
            "type": "number"
          }
        },
        "required": [
          "trading_pair_id",
          "interval"
        ]
      }
    },
    {
      "name": "get_market_metadata",
      "description": "Get metadata for a specific trading pair including tick size, min order size, and trading rules.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "trading_pair_id": {
            "type": "string",
            "description": "Trading pair UUID"
          }
        },
        "required": [
          "trading_pair_id"
        ]
      }
    },
    {
      "name": "get_orderbook",
      "description": "Get the current orderbook snapshot for a trading pair. Shows bids, asks, best bid/ask, and volumes.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "trading_pair_id": {
            "type": "string",
            "description": "Trading pair UUID"
          },
          "depth": {
            "description": "Number of price levels to return (max 100, default 10)",
            "type": "number"
          },
          "trading_mode": {
            "description": "Trading mode (default: SPOT)",
            "type": "string",
            "enum": [
              "SPOT"
            ]
          },
          "magnitude": {
            "description": "Price grouping magnitude (e.g. 0.01, 0.1, 1, 10, 100)",
            "type": "number"
          },
          "denomination": {
            "description": "Quantity denomination: BASE or QUOTE",
            "type": "string",
            "enum": [
              "BASE",
              "QUOTE"
            ]
          }
        },
        "required": [
          "trading_pair_id"
        ]
      }
    },
    {
      "name": "get_trades",
      "description": "Get historical trades for a trading pair. Returns recent trades sorted by execution time (newest first).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "trading_pair_id": {
            "type": "string",
            "description": "Trading pair UUID"
          },
          "page": {
            "description": "Page number (starts from 1, default: 1)",
            "type": "number"
          },
          "page_size": {
            "description": "Max number of records to return (default: 25, max: 100)",
            "type": "number"
          }
        },
        "required": [
          "trading_pair_id"
        ]
      }
    }
  ]
}