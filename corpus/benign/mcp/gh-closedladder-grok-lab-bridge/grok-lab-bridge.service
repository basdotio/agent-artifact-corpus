[Unit]
Description=Grok Lab Bridge (MCP server, localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/grok-lab-bridge/venv/bin/python %h/grok-lab-bridge/server.py
# Only needed when fronted by Tailscale Funnel or another proxy:
# Environment=BRIDGE_PUBLIC_HOST=<your-host>.<your-tailnet>.ts.net:8443
Restart=on-failure
RestartSec=5
# Hardening: no new privileges, private /tmp
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
