{
  "package": "@arabold/docs-mcp-server",
  "tools": [
    {
      "name": "scrape_docs",
      "description": "Scrape and index documentation from a URL for a library. Use this tool to index a new library or a new version.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Documentation root URL to scrape."
          },
          "library": {
            "type": "string",
            "description": "Library name."
          },
          "version": {
            "type": "string",
            "description": "Library version (optional)."
          },
          "maxPages": {
            "type": "number",
            "default": 1000,
            "description": "Maximum number of pages to scrape (default: 1000)."
          },
          "maxDepth": {
            "type": "number",
            "default": 3,
            "description": "Maximum navigation depth (default: 3)."
          },
          "scope": {
            "type": "string",
            "enum": [
              "subpages",
              "hostname",
              "domain"
            ],
            "default": "subpages",
            "description": "Crawling boundary: 'subpages', 'hostname', or 'domain'."
          },
          "followRedirects": {
            "type": "boolean",
            "default": true,
            "description": "Follow HTTP redirects (3xx responses)."
          },
          "preserveHashes": {
            "type": "boolean",
            "description": "Preserve hash fragments for hash-routed SPA documentation sites."
          }
        },
        "required": [
          "url",
          "library"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "refresh_version",
      "description": "Re-scrape a previously indexed library version, updating only changed pages.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library": {
            "type": "string",
            "description": "Library name."
          },
          "version": {
            "type": "string",
            "description": "Library version (optional, refreshes latest if omitted)."
          }
        },
        "required": [
          "library"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search_docs",
      "description": "Search up-to-date documentation for a library or package. Examples:\n\n- {library: \"react\", query: \"hooks lifecycle\"} -> matches latest version of React\n- {library: \"react\", version: \"18.0.0\", query: \"hooks lifecycle\"} -> matches React 18.0.0 or earlier\n- {library: \"typescript\", version: \"5.x\", query: \"ReturnType example\"} -> any TypeScript 5.x.x version\n- {library: \"typescript\", version: \"5.2.x\", query: \"ReturnType example\"} -> any TypeScript 5.2.x version",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library": {
            "type": "string",
            "description": "Library name."
          },
          "version": {
            "type": "string",
            "description": "Library version (exact or X-Range, optional)."
          },
          "query": {
            "type": "string",
            "description": "Documentation search query."
          },
          "limit": {
            "type": "number",
            "default": 5,
            "description": "Maximum number of results."
          }
        },
        "required": [
          "library",
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_libraries",
      "description": "List all indexed libraries.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "find_version",
      "description": "Find the best matching version for a library. Use to identify available or closest versions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library": {
            "type": "string",
            "description": "Library name."
          },
          "targetVersion": {
            "type": "string",
            "description": "Version pattern to match (exact or X-Range, optional)."
          }
        },
        "required": [
          "library"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_jobs",
      "description": "List all indexing jobs. Optionally filter by status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelling",
              "cancelled"
            ],
            "description": "Filter jobs by status (optional)."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_job_info",
      "description": "Get details for a specific indexing job. Use the 'list_jobs' tool to find the job ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid",
            "description": "Job ID to query."
          }
        },
        "required": [
          "jobId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "cancel_job",
      "description": "Cancel a queued or running indexing job. Use the 'list_jobs' tool to find the job ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid",
            "description": "Job ID to cancel."
          }
        },
        "required": [
          "jobId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "remove_docs",
      "description": "Remove indexed documentation for a library version. Use only if explicitly instructed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library": {
            "type": "string",
            "description": "Library name."
          },
          "version": {
            "type": "string",
            "description": "Library version (optional, removes latest if omitted)."
          }
        },
        "required": [
          "library"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "fetch_url",
      "description": "Fetch a single URL and convert its content to Markdown. Use this tool to read the content of any web page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL to fetch and convert to Markdown."
          },
          "followRedirects": {
            "type": "boolean",
            "default": true,
            "description": "Follow HTTP redirects (3xx responses)."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}