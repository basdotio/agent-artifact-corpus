            "type": "number",
            "description": "Gravity scale (for body_config)"
          },
          "mass": {
            "type": "number",
            "description": "Mass (for body_config)"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "audio",
