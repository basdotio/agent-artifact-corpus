          },
          "node_path": {
            "type": "string",
            "description": "Target node path for track"
          },
          "property": {
            "type": "string",
            "description": "Target property for track"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "tilemap",
      "description": "TileSet and TileMap management. Actions: create_tileset|add_source|set_tile|paint|list. Use help tool for full docs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create_tileset",
              "add_source",
              "set_tile",
              "paint",
              "list"
            ],
            "description": "Action to perform"
          },
          "project_path": {
            "type": "string",
