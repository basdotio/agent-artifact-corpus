{
  "package": "@robinmordasiewicz/f5xc-terraform-mcp",
  "tools": [
    {
      "name": "f5xc_terraform_discover",
      "description": "Discover available F5XC Terraform MCP tools with optional schema details",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "docs",
              "api",
              "subscription",
              "addon",
              "all"
            ],
            "default": "all",
            "description": "Filter tools by category"
          },
          "verbose": {
            "type": "boolean",
            "default": false,
            "description": "Return detailed information"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Output: 'markdown' or 'json'"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "f5xc_terraform_docs",
      "description": "F5XC Terraform docs - search, get, or list resources/data-sources/functions/guides",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "search",
              "get",
              "list"
            ],
            "description": "Action to perform"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Search query string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Resource name"
          },
          "type": {
            "type": "string",
            "enum": [
              "resource",
              "data-source",
              "function",
              "guide"
            ],
            "description": "Filter: resource|data-source|function|guide"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20,
            "description": "Max results (1-50, default: 20)"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Output: 'markdown' or 'json'"
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "f5xc_terraform_api",
      "description": "Query 270+ F5XC OpenAPI specs - search, get, find endpoints, schema definitions",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "search",
              "get",
              "find_endpoints",
              "get_definition",
              "list_definitions"
            ],
            "description": "Action to perform"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Search query string"
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "description": "URL pattern to search"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "OpenAPI spec name (e.g., 'http_loadbalancer')"
          },
          "spec_name": {
            "type": "string",
            "minLength": 1,
            "description": "OpenAPI spec name (e.g., 'http_loadbalancer')"
          },
          "definition_name": {
            "type": "string",
            "minLength": 1,
            "description": "Schema definition name"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE",
              "PATCH"
            ],
            "description": "HTTP method filter"
          },
          "include_paths": {
            "type": "boolean",
            "default": true,
            "description": "Include API endpoint paths"
          },
          "include_definitions": {
            "type": "boolean",
            "default": false,
            "description": "Include schema definitions"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "Max results (1-50, default: 20)"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Output: 'markdown' or 'json'"
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "f5xc_terraform_subscription",
      "description": "Check F5XC resource subscription tiers and advanced feature requirements",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "resource",
              "property"
            ],
            "description": "Action to perform"
          },
          "resource_name": {
            "type": "string",
            "description": "Terraform resource name"
          },
          "property_path": {
            "type": "string",
            "description": "Property path to check (e.g., \"enable_malicious_user_detection\")"
          },
          "tier": {
            "type": "string",
            "enum": [
              "STANDARD",
              "ADVANCED",
              "PREMIUM"
            ],
            "description": "Subscription tier filter"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Output: 'markdown' or 'json'"
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "f5xc_terraform_addon",
      "description": "List, check activation, and get workflows for F5XC addon services",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "check",
              "workflow"
            ],
            "description": "Action to perform"
          },
          "service_name": {
            "type": "string",
            "minLength": 1,
            "description": "Addon service identifier"
          },
          "tier": {
            "type": "string",
            "enum": [
              "STANDARD",
              "ADVANCED",
              "PREMIUM"
            ],
            "description": "Subscription tier filter"
          },
          "activation_type": {
            "type": "string",
            "enum": [
              "self",
              "partial",
              "managed"
            ],
            "description": "Filter or override activation type"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Output: 'markdown' or 'json'"
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "f5xc_terraform_metadata",
      "description": "Query resource metadata for deterministic Terraform configuration generation. Operations: minimum_config (minimal required fields with recommended values), oneof (mutually exclusive fields), validation (regex/range patterns), defaults, enums, attribute (full metadata), requires_replace, tier (subscription requirements), dependencies (creation order), troubleshoot (error remediation), syntax (correct Terraform block vs attribute syntax), validate (check config for syntax errors), example (generate complete working examples), mistakes (common errors and fixes), summary.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "oneof",
              "validation",
              "defaults",
              "enums",
              "attribute",
              "requires_replace",
              "tier",
              "dependencies",
              "troubleshoot",
              "summary",
              "syntax",
              "validate",
              "example",
              "mistakes",
              "minimum_config"
            ],
            "description": "Action to perform"
          },
          "resource": {
            "type": "string",
            "minLength": 1,
            "description": "Resource name (e.g., \"http_loadbalancer\", \"namespace\")"
          },
          "attribute": {
            "type": "string",
            "minLength": 1,
            "description": "Attribute name for attribute operation"
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "description": "Validation pattern name (e.g., \"name\", \"domain\", \"port\") or example pattern (e.g., \"basic\", \"with_waf\", \"full\")"
          },
          "tier": {
            "type": "string",
            "enum": [
              "STANDARD",
              "ADVANCED",
              "PREMIUM"
            ],
            "description": "Filter resources by subscription tier"
          },
          "error_code": {
            "type": "string",
            "minLength": 1,
            "description": "Error code for troubleshoot operation (e.g., \"NOT_FOUND\", \"FORBIDDEN\")"
          },
          "error_message": {
            "type": "string",
            "minLength": 1,
            "description": "Error message pattern for troubleshoot operation"
          },
          "config": {
            "type": "string",
            "description": "Terraform config snippet to validate (for validate operation)"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Output: 'markdown' or 'json'"
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "f5xc_terraform_get_summary",
      "description": "Get provider documentation and API specs summary",
      "inputSchema": {
        "type": "object",
        "properties": {
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Output format: \"markdown\" for human-readable or \"json\" for machine-readable"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "f5xc_terraform_auth",
      "description": "Check authentication status, list/switch profiles, validate credentials",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "status",
              "list",
              "switch",
              "validate",
              "terraform-env",
              "terraform-block"
            ],
            "description": "Action to perform"
          },
          "profile_name": {
            "type": "string",
            "minLength": 1,
            "description": "Profile name to switch to (for switch operation)"
          },
          "output_type": {
            "type": "string",
            "enum": [
              "shell",
              "dotenv",
              "json"
            ],
            "default": "shell",
            "description": "Output format for terraform-env: shell exports, .env format, or JSON"
          },
          "mask_secrets": {
            "type": "boolean",
            "default": false,
            "description": "Mask sensitive values like tokens and passwords"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Output: 'markdown' or 'json'"
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}