{
  "package": "@superblocksteam/mcp-server",
  "tools": [
    {
      "name": "assign_builder_seat",
      "description": "Assign a builder seat to a user by user_id.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base_url": {
            "format": "uri",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          }
        },
        "required": [
          "base_url",
          "user_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "check_promo",
      "description": "Check whether a billing promo code is valid.",
