          },
          "code_mode": {
            "description": "When true, creates a Clark AI App (code-mode / React + TypeScript). Defaults to true.",
            "type": "boolean"
          },
          "template_name": {
            "description": "Template to use for Clark AI Apps (e.g. 'shadcn-demo-app', 'blank-app').",
            "minLength": 1,
            "type": "string"
          },
          "folder_id": {
            "format": "uuid",
