        ],
        "type": "object"
      }
    },
    {
      "name": "checkout_application",
      "description": "Check out a Superblocks application to a caller-provided directory or a temporary directory and return the checkout path. You can optionally provide commit_id to materialize a historical snapshot. Provide either app_url or application_id plus base_url.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "app_url": {
            "format": "uri",
            "type": "string"
          },
          "application_id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "base_url": {
            "format": "uri",
            "type": "string"
          },
          "branch": {
            "minLength": 1,
            "type": "string"
          },
          "commit_id": {
            "description": "Optional application commit ID for checking out a historical application snapshot.",
            "minLength": 1,
            "type": "string"
          },
          "destination_path": {
            "description": "Optional checkout path. Must not resolve to a filesystem root.",
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "contact_sales",
      "description": "Submit a contact-sales request using the billing contact payload.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base_url": {
            "format": "uri",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "description": "Request payload object forwarded directly to the corresponding server endpoint.",
            "type": "object"
          },
          "extend": {
            "description": "When true, request a temporary extension for billing/trial.",
            "type": "boolean"
          }
        },
        "required": [
          "base_url",
          "payload"
        ],
        "type": "object"
      }
    },
    {
