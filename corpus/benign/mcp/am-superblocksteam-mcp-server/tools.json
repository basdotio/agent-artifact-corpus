          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_audit_entities",
      "description": "Legacy companion for get_audit_logs. Lists entities used to filter legacy audit logs. Prefer get_audit_events for the newer audit model and broader v2 coverage.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "base_url"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_audit_events",
      "description": "Recommended: fetch v2 audit events (OCSF) for the current organization in a time range, with cursor pagination and OCSF filters. Prefer this over legacy get_audit_logs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base_url": {
            "format": "uri",
            "type": "string"
          },
          "time_start": {
            "description": "ISO 8601 date-time string (e.g. 2025-01-01T00:00:00Z).",
            "format": "date-time",
            "type": "string"
          },
          "time_end": {
            "description": "ISO 8601 date-time string (e.g. 2025-01-01T00:00:00Z).",
            "format": "date-time",
            "type": "string"
          },
          "class_uid": {
            "description": "OCSF class UID filter (for example 6003=API_ACTIVITY, 6002=APPLICATION_LIFECYCLE, 3004=ENTITY_MANAGEMENT).",
            "type": "integer"
          },
          "status": {
            "description": "OCSF status filter (0=UNKNOWN, 1=SUCCESS, 2=FAILURE, 99=IN_PROGRESS).",
            "type": "integer"
          },
          "severity": {
            "description": "Minimum OCSF severity filter (0=UNKNOWN, 1=INFORMATIONAL, 2=LOW, 3=MEDIUM, 4=HIGH, 5=CRITICAL, 6=FATAL).",
            "type": "integer"
          },
          "actor": {
            "description": "Filter by actor user UID.",
            "type": "string"
          },
          "resource_type": {
            "description": "Filter by resource type.",
            "type": "string"
          },
          "resource_id": {
            "description": "Filter by resource ID.",
            "type": "string"
          },
          "search": {
            "description": "Free-text search over audit event payloads.",
            "minLength": 1,
            "type": "string"
          },
          "cursor": {
            "description": "Pagination cursor from a previous get_audit_events response.",
            "minLength": 1,
            "type": "string"
          },
          "limit": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "base_url",
          "time_start",
          "time_end"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_audit_logs",
      "description": "Legacy audit log feed (deprecated server endpoint), primarily execution-focused (for example v1 API/workflow runs). Prefer get_audit_events for comprehensive v2 audit coverage.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base_url": {
            "format": "uri",
            "type": "string"
          },
          "start_time": {
            "description": "ISO 8601 date-time string (e.g. 2025-01-01T00:00:00Z).",
            "format": "date-time",
            "type": "string"
          },
          "end_time": {
            "description": "ISO 8601 date-time string (e.g. 2025-01-01T00:00:00Z).",
            "format": "date-time",
            "type": "string"
          },
          "entity_type": {
            "description": "Numeric entity type for audit filtering (0 = APPLICATION, 1 = WORKFLOW, 2 = SCHEDULED_JOB).",
            "type": "integer"
          },
          "audit_entity_id": {
            "description": "Entity ID to filter audit logs (e.g. an application or integration ID).",
            "type": "string"
          },
          "audit_entity_type": {
            "description": "Numeric audit entity type (0 = APPLICATION, 1 = WORKFLOW, 2 = SCHEDULED_JOB, 3 = INTEGRATION, 4 = USER, 5 = GROUP, 6 = ROLE).",
            "type": "integer"
          },
          "status": {
            "description": "Filter by execution status.",
            "enum": [
              "All",
              "Success",
              "Running",
              "Aborted",
              "Error"
            ],
            "type": "string"
          },
          "deployed": {
            "description": "Filter audit logs to only deployed (true) or non-deployed (false) executions.",
            "type": "boolean"
          },
          "triggered_by": {
            "description": "Filter by trigger source(s).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "base_url",
          "start_time",
          "end_time"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_auth_status",
      "description": "Check whether the current user is authenticated for a Superblocks environment derived from either an app_url or a base_url.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "app_url": {
            "format": "uri",
            "type": "string"
          },
          "base_url": {
            "format": "uri",
