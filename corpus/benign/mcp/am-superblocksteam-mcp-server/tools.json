    {
      "name": "get_application_commit_history",
      "description": "Fetch a paginated, reverse-chronological application commit history, including autosaves, commit metadata, committer details, and DBFS directory hashes when available. Provide either app_url or application_id plus base_url.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "app_url": {
            "format": "uri",
            "type": "string"
          },
          "application_id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
