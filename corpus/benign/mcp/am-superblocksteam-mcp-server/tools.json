        "additionalProperties": false,
        "properties": {
          "base_url": {
            "format": "uri",
            "type": "string"
          },
          "promo_code": {
            "description": "Promotion code to validate.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "base_url",
