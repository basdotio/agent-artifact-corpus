          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_billing_plan_summary",
      "description": "Get the current billing plan summary including credit allocation, usage, billing cycle dates, and deployed application counts. Requires billing:manage permission.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "base_url"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_billing_usage_daily",
      "description": "Get daily AI credit usage for a date range. Returns one row per day with the total credits consumed. Requires billing:manage permission.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base_url": {
            "format": "uri",
            "type": "string"
          },
          "start_date": {
            "description": "Start date for the billing period (YYYY-MM-DD).",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "end_date": {
            "description": "End date for the billing period (YYYY-MM-DD).",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          }
        },
        "required": [
          "base_url",
          "start_date",
          "end_date"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_billing_usage_records",
      "description": "Get per-user AI credit usage records for a date range. Returns one row per user per day with credits consumed and source. Requires billing:manage permission.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base_url": {
            "format": "uri",
            "type": "string"
          },
          "start_date": {
            "description": "Start date for the billing period (YYYY-MM-DD).",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
