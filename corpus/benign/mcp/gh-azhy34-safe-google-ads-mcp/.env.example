# =====================================================================
# Safe Google Ads FastMCP Server — Environment Configuration
# =====================================================================

# 1. Google Ads Account Configuration
# Target 10-digit Google Ads Customer ID (without dashes)
GOOGLE_ADS_CUSTOMER_ID=1234567890

# Optional: Manager (MCC) Account ID if authenticating via agency MCC
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# 2. Google Ads API Credentials (OAuth2)
# Developer token from your Google Ads Manager account
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# OAuth2 Client ID & Secret from Google Cloud Console
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_client_secret

# OAuth2 Refresh Token generated for your Google Ads account
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token

# 3. Observability & Distributed Tracing
# Local operator identifier for audit log attribution
MCP_OPERATOR=local_operator

# Optional: Google Cloud Project for centralized Cloud Logging & Cloud Trace
GOOGLE_CLOUD_PROJECT=
MCP_CLOUD_LOG_CREDENTIALS=

# Optional: Preflight gate enforcement (1 = enforced, 0 = disabled for dev)
MCP_PREFLIGHT_REQUIRED=1

# 4. Optional: Google Analytics 4 (GA4) Cross-Channel Attribution
GA4_PROPERTY_ID=
