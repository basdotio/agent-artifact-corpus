    {
      "name": "create_ticket",
      "description": "Creates a new Ticket/Task in APUtime.\nFor events (type='event'), both start and end times are required.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Ticket/Task name"
          },
          "id_ticket_project": {
            "type": "string",
            "description": "TicketProject - Search 'list_ticket_projects' for required ID"
          },
          "description": {
            "description": "Ticket/Task description",
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "task",
              "event"
            ],
            "description": "\"task\" for regular Ticket/Tasks, \"event\" for strictly scheduled events"
          },
          "start": {
            "description": "Postpone date in ISO format (e.g., \"2024-05-13 00:00\"); (required for events)",
            "type": "string"
          },
          "end": {
            "description": "Deadline date in ISO format (e.g., \"2024-06-13 00:00\"); (required for events)",
            "type": "string"
          },
          "estimated_minutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Estimated time in minutes (default: 45 for Ticket/Tasks)"
          },
          "id_ticket_person": {
            "description": "TicketPerson/User - Search 'list_ticket_persons' for required IDs; Solver(s)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id_group": {
            "description": "Group/UserGroup - Search 'list_groups' for required IDs; Group Solvers(s)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cooperation_mode": {
            "type": "boolean",
            "description": "Enable group cooperation mode. When enabled, all solvers are scheduled at the coordinated time. Only on explicit request."
          },
          "id_ticket_tag": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "TicketTag/Label - Search 'list_ticket_tags' for required IDs"
          }
        },
        "required": [
          "name",
          "id_ticket_project",
          "type"
        ]
      }
    },
