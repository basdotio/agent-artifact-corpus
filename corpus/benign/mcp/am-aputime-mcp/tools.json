    {
      "name": "create_project",
      "description": "Creates a new TicketProject in APUtime. Can be created empty or from a template",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "TicketProject name"
          },
          "description": {
            "description": "TicketProject description",
            "type": "string"
          },
          "start": {
            "type": "string",
            "description": "Postpone date in ISO format (e.g., \"2024-05-13 00:00\")"
          },
          "end": {
            "type": "string",
            "description": "Deadline date in ISO format (e.g., \"2024-06-13 00:00\")"
          },
          "id_ticket_template": {
            "type": "string",
            "description": "TicketTemplate - Search 'list_ticket_templates' for required ID"
          },
          "id_ticket_project_tag": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "TicketProjectTag/Category - Search 'list_ticket_project_tags' for required IDs"
          },
          "scheduling": {
            "type": "boolean",
            "description": "Enable AI scheduling for this TicketProject"
          },
          "default_user_role": {
            "type": "string",
            "enum": [
              "participant",
              "participant_isolated"
            ],
            "description": "Default role for users"
          },
          "default_admin_role": {
            "type": "string",
            "enum": [
              "manager",
              "participant",
              "participant_isolated"
            ],
            "description": "Default role for managers"
          }
        },
        "required": [
          "name"
        ]
      }
    },
