          "solver_mode": {
            "type": "string",
            "enum": [
              "replace",
              "merge"
            ],
            "description": "How to apply solver changes. Replace/Reassign or Merge/Append"
          }
        },
        "required": [
          "id_ticket"
        ]
      }
    },
    {
      "name": "update_ticket_solver",
      "description": "Updates an existing TicketSolver in APUtime. Supports partial updates — only provided fields are changed.\nImportant: When users asks to close the task, you should ask if they mean to set the status for all solvers or the specific one.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id_ticket_solver": {
            "type": "string",
            "description": "TicketSolver - Search in Ticket.TicketSolver 'get_ticket' for required ID"
          },
          "status": {
            "description": "TicketSolver Status",
            "type": "string",
            "enum": [
              "open",
              "working_now",
              "resolved",
              "rejected_and_closed"
            ]
          }
        },
        "required": [
          "id_ticket_solver"
        ]
      }
    },
    {
      "name": "send_chat_message",
      "description": "Sends a chat message in APUtime. Supports three destination types: project-wide, task-specific, or channel messages.\nMessages support rich formatting (bold, italic, strikethrough, links, code blocks, lists).\n\nMessage types:\n- 'projectMessage' — Sends to a project chat (requires project_id)\n- 'taskMessage' — Sends to a task thread (requires task_id)\n- 'channelMessage' — Sends to a chat channel (requires channel_id)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "message_type": {
            "type": "string",
            "enum": [
              "projectMessage",
              "taskMessage",
              "channelMessage"
            ],
            "description": "Type of chat destination"
          },
          "project_id": {
            "type": "string",
            "description": "TicketProject - Search 'list_ticket_projects' for required ID"
          },
          "task_id": {
            "type": "string",
            "description": "Ticket - Search 'list_tickets' for required ID"
          },
          "channel_id": {
            "description": "Channel ID (required for channelMessage)",
            "type": "string"
          },
          "operations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "insert": {
                  "description": "Text content of the segment",
                  "type": "string"
                },
                "bold": {
                  "default": false,
                  "description": "Bold formatting",
                  "type": "boolean"
                },
                "italic": {
                  "default": false,
                  "description": "Italic formatting",
                  "type": "boolean"
                },
                "strike": {
                  "default": false,
                  "description": "Strikethrough formatting",
                  "type": "boolean"
                },
                "link": {
                  "description": "URL to display as hyperlink",
                  "type": "string",
                  "format": "uri"
                },
                "code_block": {
                  "default": false,
                  "description": "Render as code block",
                  "type": "boolean"
                },
                "list": {
                  "description": "Render as list item type",
                  "type": "string",
                  "enum": [
                    "ordered",
                    "bullet"
                  ]
                }
              }
            },
            "description": "Message content segments"
          },
          "reply_message_id": {
            "description": "Reply in thread to this message ID",
            "type": "string"
          }
        },
        "required": [
          "message_type",
          "project_id",
          "task_id",
          "operations"
        ]
      }
    }
  ]
}