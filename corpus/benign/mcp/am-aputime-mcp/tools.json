    {
      "name": "list_ticket_timers",
      "description": "Lists time tracking entries in APUtime. Returns timer records showing which Ticket/Tasks have been timed and their durations",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Fulltext search query"
          },
          "context": {
            "description": "Context filter",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "anomaly",
                "autotracked",
                "billable",
                "exceeded",
                "not_autotracked",
                "not_billable"
              ]
            }
          },
          "id_creator": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "TicketPerson/Author - Search 'list_ticket_persons' for required IDs"
          },
          "id_ticket_tag": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "TicketTag/Label - Search 'list_ticket_tags' for required IDs"
          },
          "id_ticket_project_tag": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "TicketProjectTag/Category - Search 'list_ticket_project_tags' for required IDs"
          },
          "id_group": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group/UserGroup - Search 'list_groups' for required IDs"
          },
          "id_ticket": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ticket - Search 'list_tickets' for list of required IDs"
          },
          "id_ticket_project": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "TicketProject - Search 'list_ticket_projects' for list of required IDs"
