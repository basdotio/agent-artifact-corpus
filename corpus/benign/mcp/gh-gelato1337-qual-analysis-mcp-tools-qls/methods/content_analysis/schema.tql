# Qualitative content analysis (directed, then inductive, then theory-driven) on top of core.tql.
# What the database guarantees. How to do the analysis is in method.md; the actions in actions.yaml.

define

  attribute origin, value string @values("guide", "emergent", "theory");   # where a category comes from
  attribute parent, value string;                                           # id of the broader category
  attribute in-vivo, value string;
  attribute period, value string;                                           # when it happened, e.g. "1999" or "2001-2003"
  attribute direction, value string @values("accelerating", "decelerating", "turning point", "neutral");

  # a coded segment: one passage (or a few) that says something about the research question.
  # At least one verified quote (from core `code`); in at least one category.
  entity segment sub code,
    owns in-vivo, owns period, owns direction,
    plays categorisation:segment @card(0..);

  # a category of the coding frame. It may start empty: categories are defined before coding.
  entity content-category sub category,
    owns origin @card(1..1), owns parent,
    plays categorisation:category @card(0..);

  # a segment can be coded into several categories (content analysis allows overlap), each with a reason.
  relation categorisation, relates category @card(1..1), relates segment @card(1..1),
    owns reason @card(1..1), owns actor, owns event;
