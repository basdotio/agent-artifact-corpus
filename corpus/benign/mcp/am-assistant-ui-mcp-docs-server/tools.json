{
  "package": "@assistant-ui/mcp-docs-server",
  "tools": [
    {
      "name": "assistantUIDocs",
      "description": "Retrieve assistant-ui documentation by path. Use \"/\" to list all sections. Supports multiple paths in a single request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Documentation paths to retrieve (e.g., [\"getting-started\", \"api-reference/primitives/thread\"])"
          }
        },
        "required": [
          "paths"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "assistantUIExamples",
      "description": "List available examples or retrieve complete code for a specific example",
      "inputSchema": {
        "type": "object",
        "properties": {
          "example": {
            "type": "string",
            "description": "Example name (e.g., \"with-ai-sdk-v6\"). Leave empty to list all examples."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}