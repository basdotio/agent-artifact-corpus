{
  "tools": [
    {
      "name": "lookup_invoice",
      "description": "Read one invoice from the current workspace.",
      "annotations": {"readOnlyHint": true, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoice_id": {"type": "string", "minLength": 1},
          "workspace": {"type": "string"}
        },
        "required": ["invoice_id", "workspace"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {"invoice_id": {"type": "string"}, "total": {"type": "number"}},
        "required": ["invoice_id", "total"]
      }
    },
    {
      "name": "list_invoices",
      "description": "List invoices by their payment status.",
      "annotations": {"readOnlyHint": true, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "properties": {"status": {"type": "string", "enum": ["paid"]}},
        "required": ["status"],
        "additionalProperties": false
      }
    }
  ]
}
