{
  "tools": [
    {
      "name": "lookup_invoice",
      "description": "Read one invoice from the current workspace.",
      "annotations": {"readOnlyHint": true, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "properties": {"invoice_id": {"type": "string", "minLength": 1}},
        "required": ["invoice_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {"invoice_id": {"type": "string"}, "amount": {"type": "number"}},
        "required": ["invoice_id", "amount"]
      }
    },
    {
      "name": "list_invoices",
      "description": "List invoices by their payment status.",
      "annotations": {"readOnlyHint": true, "openWorldHint": false},
      "inputSchema": {
        "type": "object",
        "properties": {"status": {"type": "string", "enum": ["pending", "paid"]}},
        "required": ["status"],
        "additionalProperties": false
      }
    }
  ]
}
