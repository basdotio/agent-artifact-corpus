{
  "package": "@fre4x/yahoo-finance",
  "tools": [
    {
      "name": "get_quotes",
      "description": "Get real-time price quotes for multiple ticker symbols at once.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "tickers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of ticker symbols e.g. ['AAPL', 'MSFT', 'GOOGL']"
          }
        },
        "required": [
          "tickers"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_historical_prices",
      "description": "Get historical OHLCV stock price data for a ticker.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Ticker symbol e.g. 'AAPL'"
          },
          "period": {
            "default": "1mo",
            "description": "Time period",
            "type": "string",
            "enum": [
              "1d",
              "5d",
              "1mo",
              "3mo",
              "6mo",
              "1y",
              "2y",
              "5y",
              "10y",
              "ytd",
              "max"
            ]
          },
          "interval": {
            "default": "1d",
            "description": "Bar interval",
            "type": "string",
            "enum": [
              "1m",
              "2m",
              "5m",
              "15m",
              "30m",
              "60m",
              "90m",
              "1h",
              "1d",
              "5d",
              "1wk",
              "1mo",
              "3mo"
            ]
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "ticker"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_stock_info",
      "description": "Get comprehensive stock info including price, profile, and financials.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Ticker symbol e.g. 'AAPL'"
          }
        },
        "required": [
          "ticker"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_news",
      "description": "Get latest news articles for a ticker symbol.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Ticker symbol e.g. 'AAPL'"
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "ticker"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_stock_actions",
      "description": "Get stock dividend and split history.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Ticker symbol e.g. 'AAPL'"
          }
        },
        "required": [
          "ticker"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_financial_statement",
      "description": "Get income statement, balance sheet, or cashflow for a ticker.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Ticker symbol e.g. 'AAPL'"
          },
          "financial_type": {
            "type": "string",
            "enum": [
              "income_stmt",
              "quarterly_income_stmt",
              "balance_sheet",
              "quarterly_balance_sheet",
              "cashflow",
              "quarterly_cashflow"
            ],
            "description": "Type of financial statement"
          }
        },
        "required": [
          "ticker",
          "financial_type"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_holder_info",
      "description": "Get major, institutional, mutual fund, or insider holder data.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Ticker symbol e.g. 'AAPL'"
          },
          "holder_type": {
            "type": "string",
            "enum": [
              "major_holders",
              "institutional_holders",
              "mutualfund_holders",
              "insider_transactions",
              "insider_purchases",
              "insider_roster_holders"
            ],
            "description": "Type of holder information"
          }
        },
        "required": [
          "ticker",
          "holder_type"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_option_dates",
      "description": "Get available option expiration dates for a ticker.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Ticker symbol e.g. 'AAPL'"
          }
        },
        "required": [
          "ticker"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_option_chain",
      "description": "Get calls or puts option chain for a ticker and expiration date.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Ticker symbol e.g. 'AAPL'"
          },
          "expiration_date": {
            "type": "string",
            "description": "Expiration date in YYYY-MM-DD format, e.g. 2026-06-19"
          },
          "option_type": {
            "type": "string",
            "enum": [
              "calls",
              "puts"
            ],
            "description": "Option type"
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "ticker",
          "expiration_date",
          "option_type"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_recommendations",
      "description": "Get analyst recommendations or upgrade/downgrade history.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Ticker symbol e.g. 'AAPL'"
          },
          "recommendation_type": {
            "default": "recommendations",
            "description": "Type of recommendation data",
            "type": "string",
            "enum": [
              "recommendations",
              "upgrades_downgrades"
            ]
          },
          "months_back": {
            "default": 12,
            "description": "How many trailing months of upgrade/downgrade history to include",
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "ticker"
        ],
        "additionalProperties": false
      }
    }
  ]
}