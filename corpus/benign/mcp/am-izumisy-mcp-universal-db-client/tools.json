{
  "package": "@izumisy/mcp-universal-db-client",
  "tools": [
    {
      "name": "connect_database",
      "description": "Connect to a database using connection string",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "An unique name for this connection to be used as an ID"
          },
          "dialect": {
            "type": "string",
            "enum": [
              "psql",
              "mysql",
              "sqlite"
            ],
            "description": "The available database dialect (available: psql, mysql, sqlite)"
          },
          "connectionString": {
            "type": "string",
            "description": "The database connection string. e.g., postgresql://user:password@localhost:5432/dbname"
          }
        },
        "required": [
          "name",
          "dialect",
          "connectionString"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_connections",
      "description": "List all active database connections",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "disconnect_database",
      "description": "Disconnect from a database using connection ID",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connectionID": {
            "type": "string",
            "description": "The connection ID to disconnect"
          }
        },
        "required": [
          "connectionID"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "disconnect_all",
      "description": "Disconnect all active database connections",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "query_read",
      "description": "Run SELECT and other read-only SQL queries on the connected database. This tool only accepts non-destructive queries (SELECT, SHOW, DESCRIBE, EXPLAIN).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connectionID": {
            "type": "string",
            "description": "The connection ID"
          },
          "query": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The SQL queries to execute (read-only operations only)"
          }
        },
        "required": [
          "connectionID",
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "query_write",
      "description": "Run INSERT, UPDATE, DELETE and other destructive SQL queries on the connected database. Use with caution as this can modify data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connectionID": {
            "type": "string",
            "description": "The connection ID"
          },
          "query": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The SQL queries to execute (INSERT, UPDATE, DELETE, etc.)"
          }
        },
        "required": [
          "connectionID",
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}