{
  "package": "@tankpkg/mcp-server",
  "tools": [
    {
      "name": "login",
      "description": "Authenticate with Tank using GitHub OAuth device flow. Opens browser for authorization.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "timeout": {
            "description": "Timeout in milliseconds (default: 300000 = 5 minutes)",
            "type": "number"
          }
        }
      }
    },
    {
      "name": "search-skills",
      "description": "Search the Tank registry for AI agent skills",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Search query (skill name or keywords)"
          },
          "limit": {
            "default": 10,
            "description": "Maximum results to return",
            "type": "number",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "skill-info",
      "description": "Get detailed information about a specific skill from the Tank registry",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name (e.g., @org/skill-name or skill-name)"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "scan-skill",
      "description": "Scan a skill directory for security issues. Requires authentication.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "directory": {
            "description": "Directory to scan (default: current directory)",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "publish-skill",
      "description": "Publish a skill to the Tank registry. Requires authentication.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "directory": {
            "description": "Directory to publish (default: current directory)",
            "type": "string"
          },
          "visibility": {
            "default": "public",
            "description": "Package visibility",
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          },
          "dryRun": {
            "default": false,
            "description": "Validate without publishing",
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "logout",
      "description": "Log out of Tank by clearing local credentials.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "whoami",
      "description": "Show the authenticated Tank user for the current local session.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "init-skill",
      "description": "Create a new tank.json and SKILL.md template for a Tank skill.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^@[a-z0-9-]+\\/[a-z0-9][a-z0-9-]*$"
          },
          "version": {
            "default": "0.1.0",
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$"
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "directory": {
            "default": ".",
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "remove-skill",
      "description": "Remove an installed skill from the project. Removes from tank.json, tank.lock, and deletes skill files.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name in @org/name format"
          },
          "directory": {
            "description": "Project directory (defaults to current working directory)",
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "verify-skills",
      "description": "Verify that installed skills match their lockfile entries. Checks that skill directories exist and are not empty.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "description": "Specific skill name to verify (verifies all if omitted)",
            "type": "string"
          },
          "directory": {
            "description": "Project directory (defaults to current working directory)",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "link-skill",
      "description": "Link an installed skill into an agent workspace. Creates a symlink from the workspace .skills directory to the installed skill.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name in @org/name format"
          },
          "workspace": {
            "type": "string",
            "description": "Agent workspace directory path"
          },
          "directory": {
            "description": "Project directory where skills are installed (defaults to current working directory)",
            "type": "string"
          }
        },
        "required": [
          "name",
          "workspace"
        ]
      }
    },
    {
      "name": "unlink-skill",
      "description": "Unlink a skill from an agent workspace. Removes the symlink without deleting the installed skill files.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name in @org/name format"
          },
          "workspace": {
            "type": "string",
            "description": "Agent workspace directory path"
          },
          "directory": {
            "description": "Project directory where skills are installed (defaults to current working directory)",
            "type": "string"
          }
        },
        "required": [
          "name",
          "workspace"
        ]
      }
    },
    {
      "name": "doctor",
      "description": "Diagnose Tank setup and environment.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "skill-permissions",
      "description": "Display resolved permission summary for installed skills. Shows what capabilities each skill requires and checks against the project permission budget.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "directory": {
            "description": "Project directory path (defaults to current working directory)",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "install-skill",
      "description": "Install a skill from the Tank registry. Resolves version, downloads tarball, verifies SHA-512 integrity, extracts files, and updates tank.json + tank.lock.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name in @org/name format"
          },
          "version": {
            "description": "Specific version or semver range (default: latest)",
            "type": "string"
          },
          "directory": {
            "description": "Project directory (defaults to current working directory)",
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "update-skill",
      "description": "Update an installed skill to the latest compatible version within its declared semver range.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name in @org/name format"
          },
          "directory": {
            "description": "Project directory (defaults to current working directory)",
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "audit-skill",
      "description": "Show security audit results for a skill from the Tank registry.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name in @org/name format"
          },
          "version": {
            "description": "Specific version to audit (defaults to installed or latest)",
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  ]
}