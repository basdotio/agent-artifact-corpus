{
  "package": "mcp-ssh-manager",
  "tools": [
    {
      "name": "ssh_execute",
      "description": "Execute command on remote SSH server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name from configuration"
          },
          "command": {
            "type": "string",
            "description": "Command to execute"
          },
          "cwd": {
            "type": "string",
            "description": "Working directory (optional, uses default if configured)"
          },
          "timeout": {
            "type": "number",
            "description": "Command timeout in milliseconds (default: 120000, max: 300000)"
          }
        },
        "required": [
          "server",
          "command"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_upload",
      "description": "Upload file to remote SSH server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name"
          },
          "localPath": {
            "type": "string",
            "description": "Local file path"
          },
          "remotePath": {
            "type": "string",
            "description": "Remote destination path"
          }
        },
        "required": [
          "server",
          "localPath",
          "remotePath"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_download",
      "description": "Download file from remote SSH server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name"
          },
          "remotePath": {
            "type": "string",
            "description": "Remote file path"
          },
          "localPath": {
            "type": "string",
            "description": "Local destination path"
          }
        },
        "required": [
          "server",
          "remotePath",
          "localPath"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_sync",
      "description": "Synchronize files/folders between local and remote via rsync",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name from configuration"
          },
          "source": {
            "type": "string",
            "description": "Source path (use \"local:\" or \"remote:\" prefix)"
          },
          "destination": {
            "type": "string",
            "description": "Destination path (use \"local:\" or \"remote:\" prefix)"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Patterns to exclude from sync"
          },
          "dryRun": {
            "type": "boolean",
            "description": "Perform dry run without actual changes"
          },
          "delete": {
            "type": "boolean",
            "description": "Delete files in destination not in source"
          },
          "compress": {
            "type": "boolean",
            "description": "Compress during transfer"
          },
          "verbose": {
            "type": "boolean",
            "description": "Show detailed progress"
          },
          "checksum": {
            "type": "boolean",
            "description": "Use checksum instead of timestamp for comparison"
          },
          "timeout": {
            "type": "number",
            "description": "Timeout in milliseconds (default: 30000)"
          }
        },
        "required": [
          "server",
          "source",
          "destination"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_tail",
      "description": "Tail remote log files in real-time",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name from configuration"
          },
          "file": {
            "type": "string",
            "description": "Path to the log file to tail"
          },
          "lines": {
            "type": "number",
            "description": "Number of lines to show initially (default: 10)"
          },
          "follow": {
            "type": "boolean",
            "description": "Follow file for new content (default: true)"
          },
          "grep": {
            "type": "string",
            "description": "Filter lines with grep pattern"
          }
        },
        "required": [
          "server",
          "file"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_monitor",
      "description": "Monitor system resources (CPU, RAM, disk) on remote server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name from configuration"
          },
          "type": {
            "type": "string",
            "enum": [
              "overview",
              "cpu",
              "memory",
              "disk",
              "network",
              "process"
            ],
            "description": "Type of monitoring (default: overview)"
          },
          "interval": {
            "type": "number",
            "description": "Update interval in seconds for continuous monitoring"
          },
          "duration": {
            "type": "number",
            "description": "Duration in seconds for continuous monitoring"
          }
        },
        "required": [
          "server"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_history",
      "description": "View SSH command history",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Number of commands to show (default: 20)"
          },
          "server": {
            "type": "string",
            "description": "Filter by server name"
          },
          "success": {
            "type": "boolean",
            "description": "Filter by success/failure"
          },
          "search": {
            "type": "string",
            "description": "Search in commands"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_session_start",
      "description": "Start a persistent SSH session that maintains state and context",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name from configuration"
          },
          "name": {
            "type": "string",
            "description": "Optional session name for identification"
          }
        },
        "required": [
          "server"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_session_send",
      "description": "Send a command to an existing SSH session",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "description": "Session ID from ssh_session_start"
          },
          "command": {
            "type": "string",
            "description": "Command to execute in the session"
          },
          "timeout": {
            "type": "number",
            "description": "Command timeout in milliseconds (default: 30000)"
          }
        },
        "required": [
          "session",
          "command"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_session_list",
      "description": "List all active SSH sessions",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Filter by server name"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_session_close",
      "description": "Close an SSH session",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "description": "Session ID to close (or \"all\" to close all sessions)"
          }
        },
        "required": [
          "session"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_execute_group",
      "description": "Execute command on a group of servers",
      "inputSchema": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "description": "Group name (e.g., \"production\", \"staging\", \"all\")"
          },
          "command": {
            "type": "string",
            "description": "Command to execute"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "parallel",
              "sequential",
              "rolling"
            ],
            "description": "Execution strategy"
          },
          "delay": {
            "type": "number",
            "description": "Delay between servers in ms (for rolling)"
          },
          "stopOnError": {
            "type": "boolean",
            "description": "Stop execution on first error"
          },
          "cwd": {
            "type": "string",
            "description": "Working directory"
          }
        },
        "required": [
          "group",
          "command"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_group_manage",
      "description": "Manage server groups (create, update, delete, list)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete",
              "list",
              "add-servers",
              "remove-servers"
            ],
            "description": "Action to perform"
          },
          "name": {
            "type": "string",
            "description": "Group name"
          },
          "servers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Server names"
          },
          "description": {
            "type": "string",
            "description": "Group description"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "parallel",
              "sequential",
              "rolling"
            ],
            "description": "Execution strategy"
          },
          "delay": {
            "type": "number",
            "description": "Delay between servers in ms"
          },
          "stopOnError": {
            "type": "boolean",
            "description": "Stop on error flag"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_list_servers",
      "description": "List all configured SSH servers",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "ssh_deploy",
      "description": "Deploy files to remote server with automatic permission handling",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name or alias"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "local": {
                  "type": "string",
                  "description": "Local file path"
                },
                "remote": {
                  "type": "string",
                  "description": "Remote file path"
                }
              },
              "required": [
                "local",
                "remote"
              ],
              "additionalProperties": false
            },
            "description": "Array of files to deploy"
          },
          "options": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "description": "Set file owner (e.g., \"user:group\")"
              },
              "permissions": {
                "type": "string",
                "description": "Set file permissions (e.g., \"644\")"
              },
              "backup": {
                "type": "boolean",
                "default": true,
                "description": "Backup existing files"
              },
              "restart": {
                "type": "string",
                "description": "Service to restart after deployment"
              },
              "sudoPassword": {
                "type": "string",
                "description": "Sudo password if needed (use with caution)"
              }
            },
            "additionalProperties": false,
            "description": "Deployment options"
          }
        },
        "required": [
          "server",
          "files"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_execute_sudo",
      "description": "Execute command with sudo on remote server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name or alias"
          },
          "command": {
            "type": "string",
            "description": "Command to execute with sudo"
          },
          "password": {
            "type": "string",
            "description": "Sudo password (will be masked in output)"
          },
          "cwd": {
            "type": "string",
            "description": "Working directory"
          },
          "timeout": {
            "type": "number",
            "description": "Command timeout in milliseconds (default: 30000)"
          }
        },
        "required": [
          "server",
          "command"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_command_alias",
      "description": "Manage command aliases for frequently used commands",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "list",
              "suggest"
            ],
            "description": "Action to perform"
          },
          "alias": {
            "type": "string",
            "description": "Alias name (for add/remove)"
          },
          "command": {
            "type": "string",
            "description": "Command to alias (for add) or search term (for suggest)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_hooks",
      "description": "Manage automation hooks for SSH operations",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "enable",
              "disable",
              "status"
            ],
            "description": "Action to perform"
          },
          "hook": {
            "type": "string",
            "description": "Hook name (for enable/disable)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_profile",
      "description": "Manage SSH Manager profiles for different project types",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "switch",
              "current"
            ],
            "description": "Action to perform"
          },
          "profile": {
            "type": "string",
            "description": "Profile name (for switch)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_connection_status",
      "description": "Check status of SSH connections and manage connection pool",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "status",
              "reconnect",
              "disconnect",
              "cleanup"
            ],
            "description": "Action to perform"
          },
          "server": {
            "type": "string",
            "description": "Server name (for reconnect/disconnect)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_tunnel_create",
      "description": "Create SSH tunnel (port forwarding or SOCKS proxy)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name or alias"
          },
          "type": {
            "type": "string",
            "enum": [
              "local",
              "remote",
              "dynamic"
            ],
            "description": "Tunnel type"
          },
          "localHost": {
            "type": "string",
            "description": "Local host (default: 127.0.0.1)"
          },
          "localPort": {
            "type": "number",
            "description": "Local port"
          },
          "remoteHost": {
            "type": "string",
            "description": "Remote host (not needed for dynamic)"
          },
          "remotePort": {
            "type": "number",
            "description": "Remote port (not needed for dynamic)"
          }
        },
        "required": [
          "server",
          "type",
          "localPort"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_tunnel_list",
      "description": "List active SSH tunnels",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Filter by server name"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_tunnel_close",
      "description": "Close an SSH tunnel",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tunnelId": {
            "type": "string",
            "description": "Tunnel ID to close"
          },
          "server": {
            "type": "string",
            "description": "Close all tunnels for this server"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_key_manage",
      "description": "Manage SSH host keys for security verification",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "verify",
              "accept",
              "remove",
              "list",
              "check"
            ],
            "description": "Action to perform"
          },
          "server": {
            "type": "string",
            "description": "Server name (required for most actions)"
          },
          "autoAccept": {
            "type": "boolean",
            "description": "Automatically accept new keys (use with caution)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_alias",
      "description": "Manage server aliases for easier access",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "list"
            ],
            "description": "Action to perform"
          },
          "alias": {
            "type": "string",
            "description": "Alias name (for add/remove)"
          },
          "server": {
            "type": "string",
            "description": "Server name (for add)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_backup_create",
      "description": "Create backup of database or files on remote server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name"
          },
          "type": {
            "type": "string",
            "enum": [
              "mysql",
              "postgresql",
              "mongodb",
              "files",
              "full"
            ],
            "description": "Backup type: mysql, postgresql, mongodb, files, or full"
          },
          "name": {
            "type": "string",
            "description": "Backup name (e.g., production, app-data)"
          },
          "database": {
            "type": "string",
            "description": "Database name (required for db types)"
          },
          "dbUser": {
            "type": "string",
            "description": "Database user"
          },
          "dbPassword": {
            "type": "string",
            "description": "Database password"
          },
          "dbHost": {
            "type": "string",
            "description": "Database host (default: localhost)"
          },
          "dbPort": {
            "type": "number",
            "description": "Database port"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Paths to backup (for files type)"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Patterns to exclude from backup"
          },
          "backupDir": {
            "type": "string",
            "description": "Backup directory (default: /var/backups/ssh-manager)"
          },
          "retention": {
            "type": "number",
            "description": "Retention period in days (default: 7)"
          },
          "compress": {
            "type": "boolean",
            "description": "Compress backup (default: true)"
          }
        },
        "required": [
          "server",
          "type",
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_backup_list",
      "description": "List available backups on remote server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name"
          },
          "type": {
            "type": "string",
            "enum": [
              "mysql",
              "postgresql",
              "mongodb",
              "files",
              "full"
            ],
            "description": "Filter by backup type"
          },
          "backupDir": {
            "type": "string",
            "description": "Backup directory (default: /var/backups/ssh-manager)"
          }
        },
        "required": [
          "server"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_backup_restore",
      "description": "Restore from a backup on remote server",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name"
          },
          "backupId": {
            "type": "string",
            "description": "Backup ID to restore"
          },
          "database": {
            "type": "string",
            "description": "Target database name (for db restores)"
          },
          "dbUser": {
            "type": "string",
            "description": "Database user"
          },
          "dbPassword": {
            "type": "string",
            "description": "Database password"
          },
          "dbHost": {
            "type": "string",
            "description": "Database host (default: localhost)"
          },
          "dbPort": {
            "type": "number",
            "description": "Database port"
          },
          "targetPath": {
            "type": "string",
            "description": "Target path for files restore (default: /)"
          },
          "backupDir": {
            "type": "string",
            "description": "Backup directory (default: /var/backups/ssh-manager)"
          }
        },
        "required": [
          "server",
          "backupId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ssh_backup_schedule",
      "description": "Schedule automatic backups using cron",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "description": "Server name"
          },
          "schedule": {
            "type": "string",
            "description": "Cron schedule (e.g., \"0 2 * * *\" for daily at 2 AM)"
          },
          "type": {
            "type": "string",
            "enum": [
              "mysql",
              "postgresql",
              "mongodb",
              "files"
            ],
            "description": "Backup type"
