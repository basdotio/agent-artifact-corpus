{
  "package": "@fre4x/fred",
  "tools": [
    {
      "name": "search_series",
      "description": "Search FRED economic data series by text query.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search text e.g. 'gdp', 'unemployment'"
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_series_info",
      "description": "Get metadata for a specific FRED series.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "series_id": {
            "type": "string",
            "description": "Series ID e.g. 'GDP', 'UNRATE'"
          }
        },
        "required": [
          "series_id"
        ]
      }
    },
    {
      "name": "get_series_data",
      "description": "Get observation data points for a specific FRED series.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "series_id": {
            "type": "string",
            "description": "Series ID e.g. 'GDP'"
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "series_id"
        ]
      }
    },
    {
      "name": "get_category_series",
      "description": "Get series belonging to a specific FRED category.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category_id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Category ID e.g. 125"
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "category_id"
        ]
      }
    },
    {
      "name": "get_releases",
      "description": "Get all economic data releases from FRED.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "name": "get_release_series",
      "description": "Get series belonging to a specific FRED release.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "release_id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Release ID"
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "release_id"
        ]
      }
    },
    {
      "name": "get_sources",
      "description": "Get all data sources available in FRED.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "name": "get_source",
      "description": "Get details for a specific FRED data source.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source_id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Source ID"
          }
        },
        "required": [
          "source_id"
        ]
      }
    }
  ]
