{
  "name": "hats-mcp-server",
  "version": "0.0.1",
  "description": "Hats Protocol MCP Server",
  "license": "MIT",
  "author": "",
  "homepage": "",
  "type": "module",
  "bin": {
    "hats-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "prebuild": "rm -rf dist",
    "build": "tsc && npm run copy-resources",
    "copy-resources": "cp -r resources dist/",
    "watch": "tsc --watch",
    "test": "tsc && node --experimental-specifier-resolution=node dist/test.js",
    "start:http": "PORT=3001 SERVER_MODE=http node -r dotenv/config --experimental-specifier-resolution=node dist/index.js",
    "start": "SERVER_MODE=stdio node -r dotenv/config --experimental-specifier-resolution=node dist/index.js",
    "start:dev": "tsc && (tsc --watch & SERVER_MODE=stdio node -r dotenv/config --experimental-specifier-resolution=node --watch dist/index.js)",
    "start:stream": "PORT=3001 SERVER_MODE=http node -r dotenv/config --experimental-specifier-resolution=node dist/index.js"
  },
  "dependencies": {
    "@hatsprotocol/modules-sdk": "^1.5.1",
    "@hatsprotocol/sdk-v1-core": "^0.12.4",
    "@hatsprotocol/sdk-v1-subgraph": "^1.1.0",
    "@modelcontextprotocol/sdk": "1.11.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "@types/node-fetch": "^2.6.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "multiformats": "^13.3.6",
    "node-fetch": "^3.3.2",
    "universal-user-agent": "^7.0.2",
    "viem": "2.28.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/lodash": "^4.17.17",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
