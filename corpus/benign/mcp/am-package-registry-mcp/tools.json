{
  "package": "package-registry-mcp",
  "tools": [
    {
      "name": "get-cargo-package-details",
      "description": "Get detailed information about a specific Cargo package",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search-cargo-packages",
      "description": "Search the Cargo registry for packages",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          },
          "query": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list-cargo-package-versions",
      "description": "List all versions of a specific Cargo package",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get-github-advisory",
      "description": "Get detailed information about a specific GitHub Security Advisory by its GHSA ID (e.g., GHSA-grv7-fg5c-xmjg).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ghsaId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}$",
            "description": "The GitHub Security Advisory ID (e.g., GHSA-grv7-fg5c-xmjg)"
          }
        },
        "required": [
          "ghsaId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search-github-advisories",
      "description": "Search the GitHub Security Advisory Database for vulnerabilities. Filter by ecosystem (npm, pip, maven, etc.), severity, type, or CVE ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cveId": {
            "type": "string",
            "description": "Filter by CVE identifier"
          },
          "ecosystem": {
            "type": "string",
            "enum": [
              "actions",
              "composer",
              "erlang",
              "go",
              "maven",
              "npm",
              "nuget",
              "other",
              "pip",
              "pub",
              "rubygems",
              "rust",
              "swift"
            ],
            "description": "Filter by package ecosystem (npm, pip, maven, etc.)"
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 30,
            "description": "Maximum number of results to return"
          },
          "severity": {
            "type": "string",
            "enum": [
              "unknown",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "description": "Filter by severity level (low, medium, high, critical)"
          },
          "type": {
            "type": "string",
            "enum": [
              "reviewed",
              "malware",
              "unreviewed"
            ],
            "description": "Filter by advisory type (reviewed, malware, unreviewed)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get-package-advisories",
      "description": "Get all security advisories affecting a specific package. Use this to check if a package like \"braces\" or \"lodash\" has known vulnerabilities.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ecosystem": {
            "type": "string",
            "enum": [
              "actions",
              "composer",
              "erlang",
              "go",
              "maven",
              "npm",
              "nuget",
              "other",
              "pip",
              "pub",
              "rubygems",
              "rust",
              "swift"
            ],
            "description": "The package ecosystem (npm, pip, maven, go, rust, etc.)"
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 30,
            "description": "Maximum number of results to return"
          },
          "packageName": {
            "type": "string",
            "minLength": 1,
            "description": "The package name (e.g., braces, lodash, requests)"
          },
          "severity": {
            "type": "string",
            "enum": [
              "unknown",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "description": "Filter by severity level (low, medium, high, critical)"
          }
        },
        "required": [
          "ecosystem",
          "packageName"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get-golang-package-details",
