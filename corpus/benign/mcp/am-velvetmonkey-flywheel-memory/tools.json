{
  "package": "@velvetmonkey/flywheel-memory",
  "tools": [
    {
      "name": "doctor",
      "description": "Use for diagnostics and runtime management. Returns vault health, named checks, stats, pipeline status, server log, or config. Does not read note content — use read or search for that. action: health | diagnosis | stats | pipeline | config | log",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "health",
              "diagnosis",
              "stats",
              "pipeline",
              "config",
              "log"
            ],
            "description": "Operation: health=vault status, pipeline=indexing status, config=runtime config, log=activity log"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "summary",
                  "full"
                ]
              },
              {
                "type": "boolean"
              }
            ],
            "description": "[health] Detail level: summary or full. [pipeline] true = include per-step timings"
          },
          "mode": {
            "type": "string",
            "enum": [
              "get",
              "set"
            ],
            "description": "[config] Operation: get or set"
          },
          "key": {
            "type": "string",
            "description": "[config] Config key to update (required for set)"
          },
          "value": {
            "description": "[config] New value for the key (required for set)"
          },
          "since": {
            "type": "number",
            "description": "[log] Only return entries after this Unix timestamp (ms)"
          },
          "component": {
            "type": "string",
            "description": "[log] Filter by component (server, index, fts5, semantic, tasks, watcher, statedb, config)"
          },
          "limit": {
            "type": "number",
            "description": "[log] Max entries to return (default 100)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "refresh_index",
      "description": "Use when the vault index seems stale or after bulk external edits. Produces a full rebuild of the vault index and FTS5 search database. Returns rebuild duration and note count. Does not restart the server — only rebuilds the in-memory index.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "search",
      "description": "Read-only query of vault notes. action=query (default): keyword/concept/date search. action=similar: content-overlap neighbours of a given note path. Returns ranked results with frontmatter, links, section provenance, and confidence scores; cross-vault search may also include partial_failure and vault_errors. Does not perform mutations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "query",
              "similar"
            ],
            "description": "Operation: query (default) | similar"
          },
          "query": {
            "type": "string",
            "description": "[query] Search query text. Required for action=query unless using date filters. For folder/tags/frontmatter enumeration, use find_notes."
          },
          "modified_after": {
            "type": "string",
            "description": "[query] Only notes modified after this date (YYYY-MM-DD)"
          },
          "modified_before": {
            "type": "string",
            "description": "[query] Only notes modified before this date (YYYY-MM-DD)"
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "modified",
              "created",
              "title"
            ],
            "default": "modified",
            "description": "[query] Field to sort by"
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "default": "desc",
            "description": "[query] Sort order"
          },
          "prefix": {
            "type": "boolean",
            "default": false,
            "description": "[query] Enable prefix matching for entity search (autocomplete)"
          },
          "limit": {
            "type": "number",
            "default": 10,
            "description": "[query|similar] Maximum number of results to return"
          },
          "detail_count": {
            "type": "number",
            "description": "[query] Number of top results to return with full metadata (backlinks, outlinks, headings, frontmatter). Remaining results get lightweight summaries. Default: 5."
          },
          "context_note": {
            "type": "string",
            "description": "[query] Path of the note providing context. When set, results connected to this note via weighted edges get an RRF boost."
          },
          "consumer": {
            "type": "string",
            "enum": [
              "llm",
              "human"
            ],
            "default": "llm",
            "description": "[query] Output format: \"llm\" applies sandwich ordering and strips scoring fields for context efficiency. \"human\" preserves score order and all scoring metadata for UI display."
          },
          "path": {
            "type": "string",
            "description": "[similar] Path to the source note (relative to vault root, e.g. \"projects/alpha.md\"). Required for action=similar."
          },
          "diversity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "[similar] Relevance vs diversity tradeoff (0=max diversity, 1=pure relevance, default: 0.7)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "find_notes",
      "description": "Enumerate notes by metadata — folder, tags, or frontmatter values. Use when you need a structural list, not relevance-ranked search. Returns lightweight note summaries (path, title, modified, frontmatter, tags). Does not perform full-text or semantic search — for concept search, use search instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string",
            "description": "Filter to notes inside this folder (and its subfolders)"
          },
          "where": {
            "type": "object",
            "additionalProperties": {},
            "description": "Frontmatter filters as key-value pairs. Example: { \"type\": \"project\", \"status\": \"active\" }"
          },
          "has_tag": {
            "type": "string",
            "description": "Filter to notes with this tag"
          },
          "has_any_tag": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Filter to notes with any of these tags"
          },
          "has_all_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Filter to notes with all of these tags"
          },
          "include_children": {
            "type": "boolean",
            "default": false,
            "description": "When true, tag filters also match child tags (e.g., has_tag: \"project\" also matches \"project/active\")"
          },
          "title_contains": {
            "type": "string",
            "description": "Filter to notes whose title contains this text (case-insensitive)"
          },
          "modified_after": {
            "type": "string",
            "description": "Only notes modified after this date (YYYY-MM-DD)"
          },
          "modified_before": {
            "type": "string",
            "description": "Only notes modified before this date (YYYY-MM-DD)"
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "modified",
              "created",
              "title"
            ],
            "default": "modified",
            "description": "Field to sort by"
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "default": "desc",
            "description": "Sort order"
          },
          "limit": {
            "type": "number",
            "default": 50,
            "description": "Maximum number of results to return"
          },
          "detail_count": {
            "type": "number",
            "description": "Number of top results with full metadata. Remaining get lightweight summaries. Default: 5."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "read",
      "description": "Read vault note content. action=structure (default): heading outline, frontmatter, backlinks, outlinks, word count, optional full section text — prefer over built-in Read for vault notes. action=section: text under one heading by name. action=sections: vault-wide heading search by regex. Returns enriched note metadata. Does not search or mutate.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "structure",
              "section",
              "sections"
            ],
            "description": "Operation: structure (read note outline + metadata) | section (read one section by heading) | sections (vault-wide heading search)"
          },
          "path": {
            "type": "string",
            "description": "[structure|section] Vault-relative note path"
          },
          "include_content": {
            "type": "boolean",
            "description": "[structure] Include full section text under each heading (default false)"
          },
          "max_content_chars": {
            "type": "number",
            "description": "[structure] Max total chars of section content (default 20000)"
          },
          "heading": {
            "type": "string",
            "description": "[section] Heading text to find"
          },
          "include_subheadings": {
            "type": "boolean",
            "description": "[section] Include content under subheadings (default true)"
          },
          "max_section_chars": {
            "type": "number",
            "description": "[section] Max chars of section content (default 10000)"
          },
          "pattern": {
            "type": "string",
            "description": "[sections] Regex to match heading text"
          },
          "folder": {
            "type": "string",
            "description": "[sections] Limit to notes in this folder"
          },
          "limit": {
            "type": "number",
            "description": "[sections] Max results (default 50)"
          },
          "offset": {
            "type": "number",
            "description": "[sections] Results to skip for pagination (default 0)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "tasks",
      "description": "Use to list, filter, or toggle tasks in the vault. Returns task items with path, status, and text. Does not create tasks — use vault_add_task for that. action: list (filter by status/folder/tag/path) | toggle (check/uncheck by path + text match)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "toggle"
            ],
            "default": "list",
            "description": "Operation: list=query tasks (default), toggle=check/uncheck a task"
          },
          "path": {
            "type": "string",
            "description": "[list] Scope to tasks from this note path. [toggle] Note containing the task (required for toggle)"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "completed",
              "cancelled"
            ],
            "default": "open",
            "description": "[list] Filter by task status"
          },
          "has_due_date": {
            "type": "boolean",
            "description": "[list] Only return tasks with due dates"
          },
          "folder": {
            "type": "string",
            "description": "[list] Limit to notes in this folder"
          },
          "tag": {
            "type": "string",
            "description": "[list] Filter to tasks with this tag"
          },
          "limit": {
            "type": "number",
            "default": 25,
            "description": "[list] Maximum tasks to return"
          },
          "offset": {
            "type": "number",
            "default": 0,
            "description": "[list] Results to skip (pagination)"
          },
          "task": {
            "type": "string",
            "description": "[toggle] Task text to find (partial match)"
          },
          "section": {
            "type": "string",
            "description": "[toggle] Limit task search to this section"
          },
          "commit": {
            "type": "boolean",
            "default": false,
            "description": "[toggle] Commit this change to git"
          },
          "dry_run": {
            "type": "boolean",
            "default": false,
            "description": "[toggle] Preview without writing"
          },
          "agent_id": {
            "type": "string",
            "description": "[toggle] Agent identifier for scoping"
          },
          "session_id": {
            "type": "string",
            "description": "[toggle] Session identifier for scoping"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "vault_add_task",
      "description": "Use when adding a new task checkbox to a note section. Produces a markdown task line inserted under the specified heading. Returns the written task text with line number. Does not toggle existing tasks — use vault_toggle_task to check or uncheck.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Vault-relative path to the note"
          },
          "section": {
            "type": "string",
            "description": "Section to add the task to"
          },
          "task": {
            "type": "string",
            "description": "Task text (without checkbox)"
          },
          "position": {
            "type": "string",
            "enum": [
              "append",
              "prepend"
            ],
            "default": "append",
            "description": "Where to add the task"
          },
          "completed": {
            "type": "boolean",
            "default": false,
            "description": "Whether the task should start as completed"
          },
          "commit": {
            "type": "boolean",
            "default": false,
            "description": "If true, commit this change to git (creates undo point)"
          },
          "skipWikilinks": {
            "type": "boolean",
            "default": false,
            "description": "If true, skip auto-wikilink application (wikilinks are applied by default)"
          },
          "suggestOutgoingLinks": {
            "type": "boolean",
            "default": false,
            "description": "Append suggested outgoing wikilinks based on content (e.g., \"→ [[AI]], [[Philosophy]]\"). Off by default — set true for daily notes, journals, or capture-heavy contexts."
          },
          "maxSuggestions": {
            "type": "number",
            "minimum": 1,
            "maximum": 10,
            "default": 5,
            "description": "Maximum number of suggested wikilinks to append (1-10, default: 5)"
          },
          "preserveListNesting": {
            "type": "boolean",
            "default": true,
            "description": "Preserve indentation when inserting into nested lists. Default: true"
          },
          "validate": {
            "type": "boolean",
            "default": true,
            "description": "Check input for common issues"
          },
          "normalize": {
            "type": "boolean",
            "default": true,
            "description": "Auto-fix common issues before formatting"
          },
          "guardrails": {
            "type": "string",
            "enum": [
              "warn",
              "strict",
              "off"
            ],
            "default": "warn",
            "description": "Output validation mode"
          },
          "dry_run": {
            "type": "boolean",
            "default": false,
            "description": "Preview changes without writing to disk"
          },
          "agent_id": {
            "type": "string",
            "description": "Agent identifier for multi-agent scoping"
          },
          "session_id": {
            "type": "string",
            "description": "Session identifier for conversation scoping"
          }
        },
        "required": [
          "path",
          "section",
          "task"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "vault_update_frontmatter",
      "description": "Use when setting or changing metadata fields on a note. Produces a frontmatter merge that preserves existing fields and adds or overwrites specified keys. Returns updated frontmatter object. Does not overwrite unspecified fields. Set only_if_missing to true to backfill without clobbering.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Vault-relative path to the note"
          },
          "frontmatter": {
            "type": "object",
            "additionalProperties": {},
            "description": "Frontmatter fields to update (JSON object)"
          },
          "only_if_missing": {
            "type": "boolean",
            "default": false,
            "description": "If true, only add fields that don't already exist in the frontmatter (skip existing keys)"
          },
          "commit": {
            "type": "boolean",
            "default": false,
            "description": "If true, commit this change to git (creates undo point)"
          },
          "dry_run": {
            "type": "boolean",
            "default": false,
            "description": "Preview changes without writing to disk"
          }
        },
        "required": [
          "path",
          "frontmatter"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "policy",
      "description": "Vault workflows. action: list — show policies. validate — check YAML and note refs. preview — dry-run. execute — run with compensating rollback on failure. author — generate YAML from description. revise — modify policy. Returns results or YAML. Does not run arbitrary code. e.g. { action:\"list\" } { action:\"execute\", policy:\"weekly-review\" }",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "validate",
              "preview",
              "execute",
              "author",
              "revise"
            ],
            "description": "Operation to perform"
          },
          "yaml": {
            "type": "string",
            "description": "[validate] Policy YAML content"
          },
          "policy": {
            "type": "string",
            "description": "[preview|execute|revise] Policy name or full YAML content"
          },
          "variables": {
            "type": "object",
            "additionalProperties": {},
            "description": "[preview|execute] Variables to pass to the policy"
          },
          "commit": {
            "type": "boolean",
            "description": "[execute] If true, commit successful changes in one git commit after execution"
          },
          "name": {
            "type": "string",
            "description": "[author] Name for the policy"
          },
          "description": {
            "type": "string",
            "description": "[author] Description of what the policy should do"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "description": "Tool to call (e.g., edit_section)"
                },
                "description": {
                  "type": "string",
                  "description": "What this step does"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {},
                  "description": "Parameters for the tool"
                }
              },
              "required": [
                "tool",
                "description",
                "params"
              ],
              "additionalProperties": false
            },
            "description": "[author] Steps the policy should perform"
          },
          "authorVariables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Variable name"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "array",
                    "enum"
                  ],
                  "description": "Variable type"
                },
                "required": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether variable is required"
                },
                "default": {
                  "description": "Default value"
                },
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Allowed values for enum type"
                },
                "description": {
                  "type": "string",
                  "description": "Variable description"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": false
            },
            "description": "[author] Variables the policy accepts"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Condition ID"
                },
                "check": {
                  "type": "string",
                  "description": "Condition type (file_exists, section_exists, etc.)"
                },
                "path": {
                  "type": "string",
                  "description": "File path"
                },
                "section": {
                  "type": "string",
                  "description": "Section name"
                },
                "field": {
                  "type": "string",
                  "description": "Frontmatter field"
                },
                "value": {
                  "description": "Expected value"
                }
              },
              "required": [
                "id",
                "check"
              ],
              "additionalProperties": false
            },
            "description": "[author] Conditions for conditional execution"
          },
          "save": {
            "type": "boolean",
            "description": "[author|revise] If true, save to .flywheel/policies/"
          },
          "changes": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "New description"
              },
              "addVariables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "number",
                        "boolean",
                        "array",
                        "enum"
                      ]
                    },
                    "required": {
                      "type": "boolean",
                      "default": true
                    },
                    "default": {},
                    "enum": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "additionalProperties": false
                },
                "description": "Variables to add"
              },
              "removeVariables": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Variable names to remove"
              },
              "addSteps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "tool": {
                      "type": "string"
                    },
                    "params": {
                      "type": "object",
                      "additionalProperties": {}
                    },
                    "when": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "afterStep": {
                      "type": "string",
                      "description": "Insert after this step ID"
                    }
                  },
                  "required": [
                    "id",
                    "tool",
                    "params"
                  ],
                  "additionalProperties": false
                },
                "description": "Steps to add"
              },
              "removeSteps": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Step IDs to remove"
              },
              "addConditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "check": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "section": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "id",
                    "check"
                  ],
                  "additionalProperties": false
                },
                "description": "Conditions to add"
              },
              "removeConditions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Condition IDs to remove"
              }
            },
            "additionalProperties": false,
            "description": "Changes to make (required for \"revise\")"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "init_semantic",
      "description": "Run once to build vector embeddings for hybrid search. Produces an embedding index over all notes and entities. Returns embedding count and build duration. Does not run automatically — must be invoked explicitly. After building, search (action=query and action=similar) automatically uses semantic matching alongside BM25.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "force": {
            "type": "boolean",
            "description": "Clear and rebuild all embeddings from scratch (default: false)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "note",
      "description": "Create, move, rename, or delete a vault note. action: create — new note with optional content and frontmatter. action: move — relocate note (rewires backlinks). action: rename — rename file (rewires wikilinks). action: delete — remove note (requires confirm:true). Returns mutation result with path and rewired backlinks. Does not edit note content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "move",
              "rename",
              "delete"
            ],
            "description": "Operation to perform: create | move | rename | delete"
          },
          "path": {
            "type": "string",
            "description": "Vault-relative path of the note to act on (e.g., \"projects/my-note.md\")"
          },
          "content": {
