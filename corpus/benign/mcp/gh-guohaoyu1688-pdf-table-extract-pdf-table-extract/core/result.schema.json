{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","source","tables","warnings","comparisons","files"],
  "properties":{
    "schema_version":{"const":1},
    "source":{"type":"object","required":["name","sha1","page_count"],"properties":{"name":{"type":"string"},"sha1":{"type":"string","pattern":"^[a-f0-9]{40}$"},"page_count":{"type":"integer","minimum":1}}},
    "warnings":{"type":"array","items":{"type":"string"}},
    "comparisons":{"type":"array"},
    "files":{"type":"array","items":{"type":"string"}},
    "tables":{"type":"array","items":{"type":"object","required":["id","pages","headers","rows","raw_rows","bbox","engine","page_regions","quality"],"properties":{
      "id":{"type":"string"},"pages":{"type":"array","items":{"type":"integer","minimum":1}},
      "headers":{"type":"array","minItems":2,"items":{"type":"string"}},
      "rows":{"$ref":"#/$defs/rows"},"raw_rows":{"$ref":"#/$defs/rows"},
      "bbox":{"$ref":"#/$defs/box"},"engine":{"type":"string"},
      "page_regions":{"type":"array","items":{"type":"object","required":["page","bbox","cells"],"properties":{"page":{"type":"integer","minimum":1},"bbox":{"$ref":"#/$defs/box"},"cells":{"type":"array","items":{"$ref":"#/$defs/box"}}}}},
      "quality":{"type":"object","required":["row_count","column_count","empty_cell_ratio","numeric_columns","notes","ocr_mean_confidence"],"properties":{"row_count":{"type":"integer","minimum":1},"column_count":{"type":"integer","minimum":2},"empty_cell_ratio":{"type":"number","minimum":0,"maximum":1},"numeric_columns":{"type":"array","items":{"type":"integer","minimum":0}},"notes":{"type":"array","items":{"type":"string"}},"ocr_mean_confidence":{"type":["number","null"],"minimum":0,"maximum":1}}}
    }}}
  },
  "$defs":{"rows":{"type":"array","items":{"type":"array","items":{"type":["string","null"]}}},"box":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"}}}
}
