{
  "mcpServers": {
    "fsdb-reader": {
      "command": "~/work/fsdb-mcp/venv/bin/python3",
      "args": [
        "~/work/fsdb-mcp/server.py"
      ],
      "env": {
        "VERDI_HOME": "/opt/verdi",
        "LM_LICENSE_FILE":"27000@localhost",
        "LD_LIBRARY_PATH": "/opt/verdi/share/NPI/lib/linux64:/opt/verdi/platform/linux64/bin",
        "PYTHONPATH": "/opt/verdi/share/NPI/python"
      },
      "description": "FSDB waveform file reader - Query signals, scopes, and value changes from FSDB files"
    }
  }
}
