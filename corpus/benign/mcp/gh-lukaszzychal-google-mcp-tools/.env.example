# Zmienne środowiskowe – skopiuj do .env i uzupełnij
# Plik .env jest automatycznie wykluczony z Git (.gitignore)

# ─────────────────────────────────────────────────────────────────────────────
# Gemini API (wymagane dla gemini_client.py)
# Pobierz klucz z: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=twój-klucz-api-z-ai-studio

# ─────────────────────────────────────────────────────────────────────────────
# Opcjonalne – nadpisują wartości z config.py
# ─────────────────────────────────────────────────────────────────────────────

# Model Gemini (opcjonalnie, domyślnie gemini-2.5-pro)
# GEMINI_MODEL=gemini-2.5-flash

# Poziom logowania serwera MCP (DEBUG / INFO / WARNING)
# MCP_LOG_LEVEL=INFO
