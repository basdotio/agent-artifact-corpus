# ==============================================================================
# MCP LINKEDIN - CONFIGURACIÓN DE ENTORNO DE EJEMPLO
# Copia este archivo a `.env` y configura los valores correspondientes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales Directas (Opcional si usas inicio de sesión interactivo o cookies)
# ------------------------------------------------------------------------------
# LINKEDIN_EMAIL="tu_correo@ejemplo.com"
# LINKEDIN_PASSWORD="tu_password_seguro"

# ------------------------------------------------------------------------------
# 2. Rutas Personalizadas de Autenticación y Sesión (Opcional)
# Si no se definen, el servidor buscará automáticamente en:
# - ~/.config/mcp-linkedin/
# - ./config/
# - ~/.gemini/config/mcp-auth/ (si usas Antigravity)
# ------------------------------------------------------------------------------
# LINKEDIN_AUTH_DIR="./config"
# LINKEDIN_CREDS_FILE="./config/linkedin_creds.json"
# LINKEDIN_STORAGE_STATE_FILE="./config/linkedin_storage_state.json"

# ------------------------------------------------------------------------------
# 3. Parámetros del Navegador y Ejecución
# ------------------------------------------------------------------------------
# LINKEDIN_HEADLESS="true"
# BRAVE_PATH="C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe"
