{
  "package": "@contextium/mcp-server",
  "tools": [
    {
      "name": "list",
      "description": "List resources in the workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "workspaces",
              "libraries",
              "agents",
              "skills",
              "files",
              "workflows",
              "tags",
              "tag_types",
              "file_tags",
              "workspace_status"
            ],
            "description": "Resource type to list"
          },
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          },
          "libraryId": {
            "type": "string",
            "description": "Required when type=files"
          },
          "folderId": {
            "type": "string",
            "description": "Filter by folder (type=files)"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ],
            "description": "Filter by status (type=files)"
          },
          "tagTypeId": {
            "type": "string",
            "description": "Filter by tag type ID (type=tags)"
          },
          "fileId": {
            "type": "string",
            "description": "File ID to list tags for (type=file_tags)"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    {
      "name": "get",
      "description": "Get full details of a resource by ID. Use workspace_activity for recent activity logs (last 50 events). Use activity_archive to read a specific month's archived logs by YYYY-MM (e.g. 2025-02). Use workflow_activity for the activity digest since a workflow's last session.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "file",
              "agent",
              "skill",
              "workflow",
              "library",
              "file_versions",
              "library_structure",
              "file_by_path",
              "tag_type",
              "workflow_activity",
              "workspace_activity",
              "activity_archive"
            ],
            "description": "Resource type. workspace_activity: recent activity logs (no id needed). activity_archive: archived month logs (id=YYYY-MM). workflow_activity: changes since last load (id=workflowId)"
          },
          "id": {
            "type": "string",
            "description": "Resource ID"
          },
          "workspaceId": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "description": "Title or path to search for (type=file_by_path)"
          },
          "includeMetadata": {
            "type": "boolean",
            "description": "Include metadata (type=file)"
          },
          "includeArchived": {
            "type": "boolean",
            "description": "Include archived items (type=library_structure)"
          },
          "limit": {
            "type": "number",
            "description": "Max results (type=file_versions)"
          },
          "offset": {
            "type": "number",
            "description": "Pagination offset (type=file_versions)"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    {
      "name": "create",
      "description": "Create a resource in the workspace. Always provide full content for files — never empty or placeholder.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "file",
              "library",
              "agent",
              "skill",
              "tag",
              "tag_type",
              "workflow"
            ],
            "description": "Resource type to create"
          },
          "workspaceId": {
            "type": "string"
          },
          "libraryId": {
            "type": "string",
            "description": "Library ID (type=file)"
          },
          "title": {
            "type": "string",
            "description": "Title (type=file)"
          },
          "path": {
            "type": "string",
            "description": "File path (type=file)"
          },
          "content": {
            "type": "string",
            "description": "Full file content — must be complete (type=file)"
          },
          "folderId": {
            "type": "string",
            "description": "Folder ID (type=file)"
          },
          "name": {
            "type": "string",
            "description": "Name (type=library, agent, skill, tag_type, workflow)"
          },
          "description": {
            "type": "string",
            "description": "Description (type=library, agent, skill, workflow)"
          },
          "typeId": {
            "type": "string",
            "description": "Tag type ID (type=tag)"
          },
          "value": {
            "type": "string",
            "description": "Tag value (type=tag)"
          },
          "color": {
            "type": "string",
            "description": "Hex color (type=tag, tag_type)"
          },
          "slug": {
            "type": "string",
            "description": "Slug (type=tag_type)"
          },
          "icon": {
            "type": "string",
            "description": "Icon name (type=tag_type)"
          },
          "agentIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Agent IDs (type=workflow)"
          },
          "skillIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skill IDs (type=workflow)"
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tag IDs (type=workflow)"
          },
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Library IDs (type=workflow)"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    {
      "name": "update",
      "description": "Update an existing resource.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "file",
              "agent",
              "workflow",
              "project",
              "tag",
              "tag_type"
            ],
            "description": "Resource type to update"
          },
          "id": {
            "type": "string",
            "description": "Resource ID"
          },
          "workspaceId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          },
          "changeSummary": {
            "type": "string"
          },
          "createVersion": {
            "type": "boolean",
            "description": "Create version history entry (default true)"
          },
          "folderId": {
            "type": "string"
          },
          "projectId": {
            "type": "string",
            "description": "Move file to different library (type=file)"
          },
          "customContext": {
            "type": "string",
            "description": "Custom context (type=agent)"
          },
          "systemPrompt": {
            "type": "string",
            "description": "System prompt (type=agent)"
          },
          "name": {
            "type": "string",
            "description": "New name (type=agent, workflow, project, tag_type)"
          },
          "description": {
            "type": "string",
            "description": "New description (type=agent, workflow, project)"
          },
          "agentIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Agent IDs (type=workflow)"
          },
          "skillIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skill IDs (type=workflow)"
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tag IDs (type=workflow)"
          },
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Library IDs (type=workflow)"
          },
          "value": {
            "type": "string",
            "description": "Tag value (type=tag)"
          },
          "color": {
            "type": "string",
            "description": "Hex color (type=tag, tag_type)"
          },
          "typeId": {
            "type": "string",
            "description": "Tag type ID — reassign tag to different type (type=tag)"
          },
          "slug": {
            "type": "string",
            "description": "Slug (type=tag_type, project)"
          },
          "icon": {
            "type": "string",
            "description": "Icon name (type=tag_type)"
          }
        },
        "required": [
          "type",
          "id"
        ]
      }
    },
    {
      "name": "delete",
      "description": "Delete a resource (moves to trash, restorable). type: file | workflow",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "file",
              "workflow"
            ],
            "description": "Resource type: file | workflow"
          },
          "id": {
            "type": "string",
            "description": "Resource ID"
          },
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (required for workflow). If not provided, uses your default workspace."
          }
        },
        "required": [
          "type",
          "id"
        ]
      }
    },
    {
      "name": "search",
      "description": "Search documentation by text query, by tags, or find files by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "text",
              "tags",
              "files"
            ],
            "description": "text: full-text search; tags: find files matching ALL specified tags (AND logic); files: find files by partial name/title match"
          },
          "query": {
            "type": "string",
            "description": "Search query (mode=text or mode=files)"
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tag IDs to match (mode=tags)"
          },
          "workspaceId": {
            "type": "string"
          },
          "libraryId": {
            "type": "string",
            "description": "Limit search to a specific library"
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        },
        "required": [
          "mode"
        ]
      }
    },
    {
      "name": "load_workflow",
      "description": "Load complete workflow context — agents, skills, files, and libraries. Use this to initialise a full workflow session.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflowId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "includeFileContent": {
            "type": "boolean",
            "description": "Include full file content in response (default true)"
          }
        },
        "required": [
          "workflowId"
        ]
      }
    },
    {
      "name": "manage_relationship",
      "description": "Manage relationships: apply/remove tags on files, bulk-apply tags, or add/remove skills on agents.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "tag",
              "agent_skill"
            ],
            "description": "Relationship type"
          },
          "action": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "apply_bulk"
            ],
            "description": "Action to perform. apply_bulk: apply a tag to multiple files at once (type=tag only, max 100)"
          },
          "workspaceId": {
            "type": "string"
          },
          "tagId": {
            "type": "string",
            "description": "Tag ID (type=tag)"
          },
          "fileId": {
            "type": "string",
            "description": "Single file ID (type=tag, action=add or remove)"
          },
          "fileIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Multiple file IDs (type=tag, action=apply_bulk, max 100)"
          },
          "agentId": {
            "type": "string",
            "description": "Agent ID (type=agent_skill)"
          },
          "skillId": {
            "type": "string",
            "description": "Skill ID (type=agent_skill)"
          }
        },
        "required": [
          "type",
          "action"
        ]
      }
    },
    {
      "name": "marketplace",
      "description": "Browse and install from the Contextium Marketplace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "search",
              "get",
              "install"
            ],
            "description": "search: browse listings; get: full details by slug; install: add to workspace"
          },
          "query": {
            "type": "string",
            "description": "Search query (action=search)"
          },
          "itemType": {
            "type": "string",
            "enum": [
              "skill",
              "agent",
              "mcp_server"
            ],
            "description": "Filter by type (action=search)"
          },
          "category": {
            "type": "string",
            "description": "Category filter (action=search)"
          },
          "slug": {
            "type": "string",
            "description": "Listing slug (action=get or install)"
          },
          "workspaceId": {
            "type": "string",
            "description": "Target workspace (action=install)"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "harness",
      "description": "Project workflow operations — get next feature, mark passing, close session, or load project context.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "get_next_feature",
              "mark_feature_passing",
              "close_session",
              "load_harness_session"
            ],
            "description": "get_next_feature: oldest pending feature; mark_feature_passing: status:pending → status:passing; close_session: tag session log as closed; load_harness_session: full project state"
          },
          "workflowId": {
            "type": "string",
            "description": "Project workflow ID"
          },
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          },
          "featureFileId": {
            "type": "string",
            "description": "Feature file ID (action=mark_feature_passing)"
          },
          "sessionLogFileId": {
            "type": "string",
            "description": "Session log file ID (action=close_session)"
          }
        },
        "required": [
          "action",
          "workflowId"
        ]
      }
    },
    {
      "name": "figma_sync",
      "description": "Manage Figma connector integrations — list connected files or trigger a sync to pull design tokens, components, and page structure into your Contextium libraries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "sync"
            ],
            "description": "list: show all connected Figma files and their sync status; sync: trigger a full sync for a specific connection"
          },
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          },
          "integrationId": {
            "type": "string",
            "description": "Integration ID of the Figma connection to sync (required for action=sync). Get this from action=list."
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "new_project",
      "description": "Start a guided new Contextium project setup. Call this tool FIRST whenever a user wants to set up a new project in Contextium, create libraries/agents/skills for a project, get started with Contextium, or organise their AI context. Returns complete step-by-step setup instructions that you must follow exactly.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "resume_project",
      "description": "Resume a Contextium project from a session handoff — loads the project plan, finds the last handoff note, and briefs you so you can continue without losing context. Call this when the user says things like: \"resume my project\", \"continue where I left off\", \"pick up from last session\", \"what was I working on\", \"I'm back let's continue\", \"carry on from yesterday\", \"what's next in my project\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflowId": {
            "type": "string",
            "description": "Workflow ID to resume (optional — if omitted, auto-selects if only one workflow exists)"
          },
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          }
        },
        "required": []
      }
    },
    {
      "name": "contextium_help",
      "description": "Show all available Contextium capabilities and how to use them. Call this when the user asks: \"what can Contextium do\", \"help with Contextium\", \"how do I use Contextium\", \"what Contextium tools are available\", \"show me what I can do with Contextium\".",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "contextium_status",
      "description": "Show a Contextium workspace health dashboard — available workspaces, libraries, agents, skills, and workflows. Call this when the user asks: \"check Contextium status\", \"what workspace am I in\", \"what resources do I have in Contextium\", \"show my Contextium setup\", \"what libraries do I have\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          }
        },
        "required": []
      }
    },
    {
      "name": "create_resource",
      "description": "Interactively create an agent, skill, or workflow in the current Contextium workspace. Call this when the user says things like: \"create an agent\", \"make a new agent\", \"create a skill\", \"build a workflow\", \"I need a skill for X\", \"set up an agent that does X\", \"make an agent that can do X\".",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "notify_team_members",
      "description": "Notify all eligible workspace team members about a resource you just created or updated — file, workflow, agent, or library. Use this when the user says things like \"notify the team of this new file\", \"let everyone know about this workflow\", or \"notify @sarah about this\". Respects each member's notification preferences and Do Not Disturb settings. Returns how many members were notified.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          },
          "resourceType": {
            "type": "string",
            "enum": [
              "file",
              "workflow",
              "agent",
              "library"
            ],
            "description": "The type of resource being shared"
          },
          "resourceId": {
            "type": "string",
            "description": "The UUID of the resource"
          },
          "resourceName": {
            "type": "string",
            "description": "Human-readable name of the resource, used in the notification text"
          },
          "message": {
            "type": "string",
            "description": "Optional additional context to include in the notification"
          },
          "notificationType": {
            "type": "string",
            "description": "Notification preference type. Defaults to \"newFileCreated\". Use \"mention\" when notifying a specific person."
          },
          "memberNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of member display names to notify (case-insensitive). Prefer this when the user says things like \"notify Sarah\" or \"notify Tom and Alice\"."
          },
          "memberEmails": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of member email addresses to notify."
          },
          "memberIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of member UUIDs to notify. Use memberNames or memberEmails instead when possible."
          }
        },
        "required": [
          "resourceType",
          "resourceId",
          "resourceName"
        ]
      }
    },
    {
      "name": "manual_project_setup",
      "description": "Guided, interactive project setup — walks the user through creating a Contextium workspace step by step, asking for confirmation at each stage. Use when the user is present and wants to work through the setup together.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          }
        }
      }
    },
    {
      "name": "auto_project_setup",
      "description": "Autonomous one-shot project setup — creates a full Contextium workspace (library, agents, workflow, project-state.md) without asking any questions. Use when the user says \"just set it up\", \"create a project for X\", or is on mobile/voice.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Project name"
          },
          "description": {
            "type": "string",
            "description": "What the project is about — used to tailor agent system prompts"
          },
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "manual_research_setup",
      "description": "Guided, interactive research workspace setup — walks the user through creating a research workspace step by step. Use when the user is present and wants to steer the research direction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          }
        }
      }
    },
    {
      "name": "auto_research_setup",
      "description": "Autonomous one-shot research workspace setup — creates a research library, agents, and workflow without asking any questions. Use when the user says \"deep dive into X\", \"research X for me\", or is on mobile/voice.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Research topic name"
          },
          "description": {
            "type": "string",
            "description": "What to research — used to tailor agent system prompts and scope the brief"
          },
          "depth": {
            "type": "string",
            "enum": [
              "quick",
              "deep"
            ],
            "description": "quick: one research agent + summary doc. deep: Research Lead + Fact Checker + structured brief. Defaults to quick."
          },
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "capture_idea",
      "description": "Capture a quick idea, note, or seed — saves into an existing project's seeds or a general Quick Notes library. Use when the user says \"remember this\", \"note that\", \"jot this down\", or \"add this to [project]\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The idea or note to capture"
          },
          "projectName": {
            "type": "string",
            "description": "Project to attach the idea to — inferred from existing projects if omitted"
          },
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID (uses default if omitted)"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "list_identities",
      "description": "Lists identities visible to the current user in a workspace. Identities capture voice, tone, role, and audience context so AI produces work from the right perspective.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID. If not provided, uses your default workspace."
          }
        }
      }
    },
    {
      "name": "get_identity",
      "description": "Gets the full profile of a single identity by ID, including voice descriptors, writing samples, and all contextual fields.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "identityId": {
            "type": "string",
            "description": "The ID of the identity to retrieve."
          },
          "workspaceId": {
            "type": "string",
            "description": "Workspace ID. If not provided, uses your default workspace."
          }
        },
        "required": [
          "identityId"
        ]
      }
    },
    {
      "name": "create_identity",
      "description": "Creates a new identity in the workspace. Identities capture voice, tone, role, and audience context so AI produces work from the right perspective.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Identity name (required)."
          },
          "scope": {
            "type": "string",
            "enum": [
              "user",
