{
  "package": "@contextlint/mcp-server",
  "tools": [
    {
      "name": "lint",
      "description": "Lint markdown content with specified rules",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Markdown text to lint"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string",
                  "description": "Rule name (e.g. tbl001)"
                },
                "options": {
                  "description": "Rule options",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "rule"
              ]
            },
            "description": "Rules to apply"
          }
        },
        "required": [
          "content",
          "rules"
        ]
      }
    },
    {
      "name": "lint-files",
      "description": "Lint markdown files matching glob patterns using a config file or preset",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "patterns": {
            "description": "Glob patterns (default: [\"**/*.md\"])",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "configPath": {
            "description": "Config file path (default: \"contextlint.config.json\")",
            "type": "string"
          },
          "cwd": {
            "description": "Working directory (default: \".\")",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "context-graph",
      "description": "Build and return the document dependency graph for the project",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "configPath": {
            "description": "Path to contextlint.config.json",
            "type": "string"
          },
          "cwd": {
            "description": "Working directory",
            "type": "string"
          },
          "format": {
            "description": "Output format (default: summary)",
            "type": "string",
            "enum": [
              "json",
              "summary"
            ]
          }
        }
      }
    },
    {
      "name": "context-slice",
      "description": "Extract the minimal set of documents relevant to a given query (ID, keyword, or file path)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "ID, keyword, or file path to search for"
          },
          "depth": {
            "description": "Max traversal depth (default: 2)",
            "type": "number"
          },
          "configPath": {
            "description": "Path to contextlint.config.json",
            "type": "string"
          },
          "cwd": {
            "description": "Working directory",
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "impact-analysis",
      "description": "Analyze which documents are affected by changes to a given file",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Path to the changed file (relative to cwd)"
          },
          "configPath": {
            "description": "Path to contextlint.config.json",
            "type": "string"
          },
          "cwd": {
            "description": "Working directory",
            "type": "string"
          }
        },
        "required": [
          "file"
        ]
      }
    },
    {
      "name": "compile-context",
      "description": "Compile document structure into LLM-readable context text (e.g. SKILL.md). Deterministic: same config + same documents = same output.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "configPath": {
            "description": "Path to contextlint.config.json",
            "type": "string"
          },
          "cwd": {
            "description": "Working directory",
            "type": "string"
          }
        }
      }
    }
  ]
}