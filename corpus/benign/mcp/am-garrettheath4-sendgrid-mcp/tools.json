        "type": "object",
        "properties": {
          "list_id": {
            "type": "string",
            "description": "ID of the contact list to delete"
          }
        },
        "required": [
          "list_id"
        ]
      }
    },
    {
      "name": "list_contact_lists",
      "description": "List all contact lists in your SendGrid account",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "get_contacts_by_list",
