      }
    },
    {
      "name": "left_click_drag",
      "description": "Click and drag from a start coordinate to an end coordinate. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start_coordinate": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Horizontal pixel coordinate."
              },
              "y": {
                "$ref": "#/properties/start_coordinate/properties/x",
                "description": "Vertical pixel coordinate."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "description": "{x, y} pixel coordinate to start the drag from."
          },
          "coordinate": {
            "type": "object",
            "properties": {
              "x": {
                "$ref": "#/properties/start_coordinate/properties/x"
              },
              "y": {
                "$ref": "#/properties/start_coordinate/properties/y"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "description": "{x, y} pixel coordinate to drag to."
          }
        },
        "required": [
          "start_coordinate",
          "coordinate"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "left_mouse_down",
      "description": "Press and hold the left mouse button at the current cursor position. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "left_mouse_up",
      "description": "Release the left mouse button at the current cursor position. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "type",
      "description": "Type a string for text input fields. Use `key` for physical-key controls. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The text to type."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "key",
      "description": "Press a key or combo, e.g. 'Return', 'ctrl+s', 'alt+Tab', '1'. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Key combo to press (e.g. 'Return', 'ctrl+s', 'alt+Tab')."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "scroll",
      "description": "Scroll the screen in a given direction at an optional coordinate. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scroll_direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ],
            "description": "Direction to scroll."
          },
          "coordinate": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Horizontal pixel coordinate."
              },
              "y": {
                "$ref": "#/properties/coordinate/properties/x",
                "description": "Vertical pixel coordinate."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "description": "{x, y} pixel coordinate to scroll at. Scrolls at current cursor position if omitted."
          },
          "scroll_amount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Number of scroll clicks (default 3)."
          }
        },
        "required": [
          "scroll_direction"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "wait",
      "description": "Pause, then return an updated screenshot if access is active. Use after a screenshot shows the UI is not ready yet.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "duration": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Seconds to wait (max 100). Use after a screenshot shows the UI is not in the expected state yet, but an operation may still finish."
          }
        },
        "required": [
          "duration"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_clipboard",
      "description": "Get the current text contents of the system clipboard. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "set_clipboard",
      "description": "Set the system clipboard to the specified text. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The text to copy to the clipboard."
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "zoom",
      "description": "Capture a filtered screen region at full resolution. If the target app is missing, call `list_applications` then `request_access`. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "object",
            "properties": {
              "x1": {
                "type": "number",
                "description": "Left edge of the region in screenshot pixel coordinates."
              },
              "y1": {
                "$ref": "#/properties/region/properties/x1",
                "description": "Top edge of the region in screenshot pixel coordinates."
              },
              "x2": {
                "$ref": "#/properties/region/properties/x1",
                "description": "Right edge of the region in screenshot pixel coordinates."
              },
              "y2": {
                "$ref": "#/properties/region/properties/x1",
                "description": "Bottom edge of the region in screenshot pixel coordinates."
              }
            },
            "required": [
              "x1",
              "y1",
              "x2",
              "y2"
            ],
            "additionalProperties": false,
            "description": "{x1, y1, x2, y2} coordinates defining top-left and bottom-right corners of the region to capture."
          }
        },
        "required": [
          "region"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "batch",
      "description": "Run ordered actions and return one final screenshot after a built-in settle delay. Use for predictable sequences; wait is intentionally not supported. Supported actions: left_click, right_click, middle_click, double_click, triple_click, mouse_move, left_click_drag, left_mouse_down, left_mouse_up, type, key, scroll, set_clipboard.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "left_click",
                        "right_click",
                        "middle_click",
                        "double_click",
                        "triple_click"
                      ]
                    },
                    "coordinate": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "description": "Horizontal pixel coordinate."
                        },
                        "y": {
                          "$ref": "#/properties/actions/items/anyOf/0/properties/coordinate/properties/x",
                          "description": "Vertical pixel coordinate."
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false,
                      "description": "{x, y} pixel coordinate. Clicks at current cursor position if omitted."
                    }
                  },
                  "required": [
                    "action"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "mouse_move"
                    },
                    "coordinate": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "$ref": "#/properties/actions/items/anyOf/0/properties/coordinate/properties/x"
                        },
                        "y": {
                          "$ref": "#/properties/actions/items/anyOf/0/properties/coordinate/properties/y"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false,
                      "description": "{x, y} pixel coordinate to move the cursor to."
                    }
                  },
                  "required": [
                    "action",
                    "coordinate"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "left_click_drag"
                    },
                    "start_coordinate": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "$ref": "#/properties/actions/items/anyOf/0/properties/coordinate/properties/x"
                        },
                        "y": {
                          "$ref": "#/properties/actions/items/anyOf/0/properties/coordinate/properties/y"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false,
                      "description": "{x, y} pixel coordinate to start the drag from."
                    },
                    "coordinate": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "$ref": "#/properties/actions/items/anyOf/0/properties/coordinate/properties/x"
                        },
                        "y": {
                          "$ref": "#/properties/actions/items/anyOf/0/properties/coordinate/properties/y"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false,
                      "description": "{x, y} pixel coordinate to drag to."
                    }
                  },
                  "required": [
                    "action",
                    "start_coordinate",
                    "coordinate"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "left_mouse_down"
                    }
                  },
                  "required": [
                    "action"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "left_mouse_up"
                    }
                  },
                  "required": [
                    "action"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "type"
                    },
                    "text": {
                      "type": "string",
                      "description": "The text to type."
                    }
                  },
                  "required": [
                    "action",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "key"
                    },
                    "text": {
                      "type": "string",
                      "description": "Key combo to press (e.g. 'Return', 'ctrl+s', 'alt+Tab')."
                    }
                  },
                  "required": [
                    "action",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "scroll"
                    },
                    "scroll_direction": {
                      "type": "string",
                      "enum": [
                        "up",
                        "down",
                        "left",
                        "right"
                      ],
                      "description": "Direction to scroll."
                    },
                    "coordinate": {
                      "$ref": "#/properties/actions/items/anyOf/0/properties/coordinate",
                      "description": "{x, y} pixel coordinate to scroll at. Scrolls at current cursor position if omitted."
                    },
                    "scroll_amount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Number of scroll clicks (default 3)."
                    }
                  },
                  "required": [
                    "action",
                    "scroll_direction"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "const": "set_clipboard"
                    },
                    "text": {
                      "type": "string",
                      "description": "The text to copy to the clipboard."
                    }
                  },
                  "required": [
                    "action",
                    "text"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "description": "Ordered actions. Do not include waits; call the separate `wait` tool only after observing a screenshot that is not ready yet."
          }
        },
        "required": [
          "actions"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}