{
  "package": "@github/computer-use-mcp",
  "tools": [
    {
      "name": "list_displays",
      "description": "List available displays and the currently selected display used for screenshots, zoom, cursor position, and coordinate-based actions.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "select_display",
      "description": "Select the active display used for screenshots, zoom, cursor position, and coordinate-based actions. Omit display_id or pass an empty string to use the default display.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "display_id": {
            "type": "string",
            "description": "Display id to select. Omit or pass an empty string to use the default display."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_applications",
      "description": "List running apps and `selectedDisplay`. Use for discovery only; `request_access` can resolve named apps directly.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "display_id": {
            "type": "string",
            "description": "Optional display id to filter by. When provided, only apps with at least one non-minimized window on that display are returned."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "request_access",
      "description": "Request app access by friendly name or appId; pass [] for all visible apps. For a named app, call this directly; it finds the app and selects its display. Returns JSON (`allowed`, `allowAll`, `message`, `allowedApps?`, `selectedDisplay?`) and, when allowed, a screenshot. `allowAll=true` covers future apps for this session.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "apps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Application name or stable app id from `list_applications`. Examples: 'Google Chrome', 'Microsoft Outlook', 'app.windows.abc123'."
            },
            "description": "Applications to allow. Each entry can be a friendly name (e.g. \"Outlook\") or a stable appId, if already known. Pass an empty array to allow all apps on the selected display."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Optional reason text shown in the access dialog."
          }
        },
        "required": [
          "apps"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "screenshot",
      "description": "Capture the current filtered screen. Use returned post-action screenshots when available.  If the target app is missing, call `list_applications` then `request_access`. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "cursor_position",
      "description": "Get the current cursor position in pixel coordinates. Returns {x, y}. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "left_click",
      "description": "Click the left mouse button. Optionally move to a coordinate first. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "coordinate": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Horizontal pixel coordinate."
              },
              "y": {
                "$ref": "#/properties/coordinate/properties/x",
                "description": "Vertical pixel coordinate."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "description": "{x, y} pixel coordinate. Clicks at current cursor position if omitted."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
