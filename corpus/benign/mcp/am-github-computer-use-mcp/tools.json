    },
    {
      "name": "mouse_move",
      "description": "Move the mouse cursor to the specified pixel coordinate. Requires `request_access`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "coordinate": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Horizontal pixel coordinate."
              },
              "y": {
                "$ref": "#/properties/coordinate/properties/x",
                "description": "Vertical pixel coordinate."
