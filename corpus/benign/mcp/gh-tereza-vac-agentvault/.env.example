# Copy to .env and adjust. (python-dotenv not required — these are plain env vars.)

# Folder with your Markdown notes (source of truth — portable)
NOTES_DIR=./notes

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=dbname=agentvault user=agentvault password=agentvault host=localhost port=5432

# Embedding model — BGE-M3 is multilingual (great for Czech).
# On small VPS prefer: intfloat/multilingual-e5-small + EMBED_DIM=384 (then re-init-db).
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_MAX_TOKENS=1024

# MCP server (agents)
MCP_HOST=127.0.0.1
MCP_PORT=8788

# Web UI — keep 127.0.0.1; use SSH tunnel from your PC
WEB_HOST=127.0.0.1
WEB_PORT=8787

# Optional HTTP Basic auth for the web UI. Empty/unset = open. Format: user:password
# WEB_AUTH=admin:change-me

# Hybrid search weight: 1=vectors only, 0=keywords only
HYBRID_ALPHA=0.65
