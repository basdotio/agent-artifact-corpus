#!/usr/bin/env bash
# AgentVault launcher: load .env (without overriding vars already set) and run CLI in venv.
cd "$(dirname "$0")"
if [ -f .env ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; esac
    key=${line%%=*}
    val=${line#*=}
    if [ -z "${!key+x}" ]; then
      export "$key=$val"
    fi
  done < .env
fi
exec .venv/bin/python cli.py "$@"
