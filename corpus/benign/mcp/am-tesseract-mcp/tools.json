{
  "package": "tesseract-mcp",
  "tools": [
    {
      "name": "login",
      "description": "Authenticate with Tesseract cloud. If no code is provided, opens a browser for automatic pairing — authentication completes in the background. Alternatively, provide a pairing code from the Tesseract web app directly.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Optional pairing code from the Tesseract web app. If omitted, a browser-based flow will be started automatically."
          }
        }
      }
    },
    {
      "name": "get_graph",
      "description": "Get the architecture graph at a path",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "path": {
            "description": "Path to navigate (e.g. '/gateway'). Omit for root.",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "list_components",
      "description": "List all components",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_user_context",
      "description": "Get current view and selection",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_types",
      "description": "List available component types",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "screenshot",
      "description": "Take a screenshot of the architecture view",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "zoom_to_fit": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "ui",
              "graph"
            ]
          },
          "save_to_file": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "export_mermaid",
      "description": "Export architecture as Mermaid",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "import_mermaid",
      "description": "Import Mermaid diagram",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "mermaid": {
            "type": "string",
            "description": "Mermaid flowchart text"
          }
        },
        "required": [
          "mermaid"
        ]
      }
    },
    {
      "name": "add_component",
      "description": "Add a component",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "tech": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "position_x": {
            "type": "number"
          },
          "position_z": {
            "type": "number"
          },
          "parent_path": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type",
          "layer",
          "tech",
          "description"
        ]
      }
    },
    {
      "name": "update_component",
      "description": "Update a component",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "tech": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "position_x": {
            "type": "number"
          },
          "position_z": {
            "type": "number"
          },
          "parent_path": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "remove_component",
      "description": "Remove a component",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "parent_path": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "add_connection",
      "description": "Add a connection",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "bidirectional": {
            "type": "boolean"
          },
          "curvature": {
            "type": "number"
          },
          "parent_path": {
            "type": "string"
          },
          "parent_connection_id": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "protocol",
          "description"
        ]
      }
    },
    {
      "name": "update_connection",
      "description": "Update a connection",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "bidirectional": {
            "type": "boolean"
          },
          "curvature": {
            "type": "number"
          },
          "parent_path": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "remove_connection",
      "description": "Remove a connection",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "parent_path": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "update_project",
      "description": "Update project title/description",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "annotate",
      "description": "Add a note to a component",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "target_id",
          "message"
        ]
      }
    },
    {
      "name": "auto_layout",
      "description": "Run auto-layout",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "pin_all",
      "description": "Pin all components",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "unpin_components",
      "description": "Unpin components",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "ids"
        ]
      }
    },
    {
      "name": "look_at",
      "description": "Navigate camera to a component",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "select",
              "enter"
            ]
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "list_layers",
      "description": "List layers",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "add_layer",
      "description": "Add layers",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "color"
              ]
            }
          }
        },
        "required": [
          "layers"
        ]
      }
    },
    {
      "name": "update_layer",
      "description": "Update layers",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            }
          }
        },
        "required": [
          "layers"
        ]
      }
    },
    {
      "name": "remove_layer",
      "description": "Remove layers",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ids"
        ]
      }
    },
    {
      "name": "reorder_layers",
      "description": "Reorder layers",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "names"
        ]
      }
    },
    {
      "name": "highlight_path",
      "description": "Highlight a data flow path",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "component": {
                      "type": "string"
                    },
                    "via": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "component"
                  ]
                }
              ]
            }
          },
          "parent_path": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "clear_highlights",
      "description": "Clear highlights",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "save_flow",
      "description": "Save highlights as a flow",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ]
      }
    },
    {
      "name": "list_flows",
      "description": "List saved flows",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "show_flow",
      "description": "Display a saved flow",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "update_flow",
      "description": "Update a flow",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "add_path": {
            "type": "object",
            "properties": {
              "segments": {
                "type": "array",
                "items": {}
              },
              "color": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "segments"
            ]
          },
          "add_segment": {
            "type": "object",
            "properties": {
              "path_index": {
                "type": "number"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "via": {
                "type": "string"
              },
              "parentPath": {
                "type": "string"
              }
            },
            "required": [
              "path_index",
              "from",
              "to",
              "via"
            ]
          },
          "remove_path_index": {
            "type": "number"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "delete_flow",
      "description": "Delete a flow",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "prepare_download",
      "description": "Prepare download URL",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "confirm_download",
      "description": "Confirm download",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      }
    },
    {
      "name": "prepare_upload",
      "description": "Prepare upload URL",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "force": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "studio_list_collections",
      "description": "List all collections in the 3D asset staging directory.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "studio_read_inventory",
      "description": "Read the structured inventory of a collection as JSON. Returns all categories, components, their editable attributes, and pipeline status flags. Use sparingly — can be large.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection ID"
          }
        },
        "required": [
          "collection"
        ]
      }
    },
    {
      "name": "studio_read_scad",
      "description": "Read the OpenSCAD source file for a 3D component.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection ID"
          },
          "category": {
            "type": "string",
            "description": "Category ID"
          },
          "uuid": {
            "type": "string",
            "description": "Component UUID"
          }
        },
        "required": [
          "collection",
          "category",
          "uuid"
        ]
      }
    },
    {
      "name": "studio_read_preview",
      "description": "Read the preview image for a 3D component. Use this to visually inspect an existing component.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection ID"
          },
          "category": {
            "type": "string",
            "description": "Category ID"
          },
          "uuid": {
            "type": "string",
            "description": "Component UUID"
          }
        },
        "required": [
          "collection",
          "category",
          "uuid"
        ]
      }
    },
    {
      "name": "studio_get_context",
      "description": "Get the component currently selected in the staging browser UI. Returns null when no browser is connected.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "studio_write_scad",
      "description": "Write the OpenSCAD source file for a 3D component and trigger the render pipeline. If uuid is omitted, a new UUID is generated automatically. Creates metadata.json with the component name. Returns the UUID. Use get_job_result(uuid) to poll the pipeline.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection ID"
          },
          "category": {
            "type": "string",
            "description": "Category ID"
          },
          "uuid": {
            "description": "Component UUID (optional — auto-generated if omitted)",
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Display name for the component"
          },
          "content": {
            "type": "string",
            "description": "OpenSCAD source code"
          }
        },
        "required": [
          "collection",
          "category",
          "name",
          "content"
        ]
      }
    },
    {
      "name": "studio_get_job_result",
      "description": "Poll the render pipeline for a component. Returns false if still running, the multiview image (8 angles) once complete, or an error if the pipeline failed.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "Component UUID"
          }
        },
        "required": [
          "uuid"
        ]
      }
    },
    {
      "name": "studio_set_collection_attr",
      "description": "Update a collection's editable attributes (name and/or description). Other fields (id, tier, creator) are managed by the system.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection ID"
          },
          "name": {
            "description": "New display name",
            "type": "string"
          },
          "description": {
            "description": "New description",
            "type": "string"
          }
        },
        "required": [
          "collection"
        ]
      }
    },
    {
      "name": "studio_set_category_attr",
      "description": "Update a category's editable attributes (name and/or description). Other fields (id, collection, creator) are managed by the system.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection ID"
          },
          "category": {
            "type": "string",
            "description": "Category ID"
          },
          "name": {
            "description": "New display name",
            "type": "string"
          },
          "description": {
            "description": "New description",
            "type": "string"
          }
        },
        "required": [
          "collection",
          "category"
        ]
      }
    },
    {
      "name": "studio_set_component_attr",
      "description": "Update a component's editable attributes (name and/or description). Other fields (scale, offset, rotation, decals, modelRef) are managed via the UI only.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection ID"
          },
          "category": {
            "type": "string",
            "description": "Category ID"
          },
          "uuid": {
            "type": "string",
            "description": "Component UUID"
          },
          "name": {
            "description": "New display name",
            "type": "string"
          },
          "description": {
            "description": "New description",
            "type": "string"
          }
        },
        "required": [
          "collection",
          "category",
          "uuid"
        ]
      }
    },
    {
      "name": "studio_show_component",
      "description": "Show a specific component, category, or collection in the staging browser. Returns navigation metadata. Set show_first=true to auto-select the first component in the collection.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "Collection ID"
          },
          "category": {
            "description": "Category ID (optional — omit for collection-level)",
            "type": "string"
          },
          "uuid": {
            "description": "Component UUID (optional — requires category)",
            "type": "string"
          },
          "label": {
            "description": "Button label (auto-generated if omitted)",
            "type": "string"
          },
          "show_first": {
            "description": "If true, resolve to the first component in the collection",
            "type": "boolean"
          }
        },
        "required": [
          "collection"
        ]
      }
    }
  ]
}