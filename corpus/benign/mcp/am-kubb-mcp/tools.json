{
  "package": "@kubb/mcp",
  "tools": [
    {
      "name": "generate",
      "description": "Generate OpenAPI spec helpers using Kubb configuration",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "config": {
            "description": "Path to kubb.config file (supports .ts, .js, .cjs). If not provided, will look for kubb.config.{ts,js,cjs} in current directory",
            "type": "string"
          },
          "input": {
            "description": "Path to OpenAPI/Swagger spec file (overrides config)",
            "type": "string"
          },
          "output": {
            "description": "Output directory path (overrides config)",
            "type": "string"
          },
          "logLevel": {
            "default": "info",
            "description": "Log level for build output",
            "type": "string",
            "enum": [
              "silent",
              "error",
              "warn",
              "info",
              "verbose",
              "debug"
            ]
          }
        }
      }
    }
  ]
}