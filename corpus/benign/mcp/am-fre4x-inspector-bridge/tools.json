{
  "package": "@fre4x/inspector-bridge",
  "tools": [
    {
      "name": "inspector_connect",
      "description": "Spawn and connect to an MCP server. Returns session_id for subsequent calls.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "command": {
            "description": "Executable for stdio server (e.g. 'node', 'npx')",
            "type": "string"
          },
          "server_args": {
            "description": "Args passed to the command (e.g. ['dist/index.js'])",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "server_url": {
            "description": "URL for remote SSE or HTTP server",
            "type": "string",
            "format": "uri"
          },
          "transport": {
            "description": "Transport type; auto-detected from inputs if omitted",
            "type": "string",
            "enum": [
              "stdio",
              "sse",
              "http"
            ]
          },
          "env": {
            "description": "Environment variables for the target server",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "headers": {
            "description": "HTTP headers for remote connections",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "cwd": {
            "description": "Working directory when launching stdio server",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "inspector_disconnect",
      "description": "Close an active MCP server session by session_id.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "description": "Session ID returned by inspector_connect"
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "inspector_list_sessions",
      "description": "List all active MCP server sessions with their IDs and targets.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "inspector_list_tools",
      "description": "List all tools exposed by the connected MCP server.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "description": "Session ID returned by inspector_connect"
          },
          "cursor": {
            "description": "Pagination cursor from previous response (optional)",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "inspector_call_tool",
      "description": "Call a tool on the connected MCP server and return the result.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "description": "Session ID returned by inspector_connect"
          },
          "tool_name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the tool to call"
          },
          "tool_args": {
            "description": "JSON object of arguments for the tool",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "session_id",
          "tool_name"
        ]
      }
    },
    {
      "name": "inspector_list_resources",
      "description": "List all resources exposed by the connected MCP server.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "description": "Session ID returned by inspector_connect"
          },
          "cursor": {
            "description": "Pagination cursor from previous response (optional)",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "inspector_read_resource",
      "description": "Read the contents of a resource by URI from the connected MCP server.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "description": "Session ID returned by inspector_connect"
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "description": "Resource URI to read"
          }
        },
        "required": [
          "session_id",
          "uri"
        ]
      }
    },
    {
      "name": "inspector_list_resource_templates",
      "description": "List all resource URI templates from the connected MCP server.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "description": "Session ID returned by inspector_connect"
          },
          "cursor": {
            "description": "Pagination cursor from previous response (optional)",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "inspector_list_prompts",
      "description": "List all prompts exposed by the connected MCP server.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "description": "Session ID returned by inspector_connect"
          },
          "cursor": {
            "description": "Pagination cursor from previous response (optional)",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ]
      }
    },
    {
      "name": "inspector_get_prompt",
      "description": "Retrieve a rendered prompt with arguments from the connected MCP server.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "description": "Session ID returned by inspector_connect"
          },
          "prompt_name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the prompt to retrieve"
          },
          "prompt_args": {
            "description": "String key-value arguments for the prompt template",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "session_id",
          "prompt_name"
        ]
      }
    }
  ]
}