# ── Python 编译产物 ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── 打包 / 构建 ──────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ── 虚拟环境 ─────────────────────────────────────
.venv/
venv/
ENV/
env/
# 之前改名隔离的那个旧环境，别让它进仓库
.venv_old/

# ── 测试 / 静态检查缓存 ──────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── IDE ─────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── 操作系统 ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 密钥 / 本地配置 ──────────────────────────────
# 注意：这个项目不需要任何 API key，这条是为了防止以后误加
.env
.env.local
*.key

# ── 注意：sandbox/ 有意【不】忽略 ────────────────
# 里面是测试样本（bin.dat 测二进制跳过、sub/deep/c.txt 测递归搜索、
# edge_20000/20001.txt 测长度边界），README 和 TEST-CASES 都引用了它们。
# 删了这些文件，别人 clone 下来就跑不通测试清单。
