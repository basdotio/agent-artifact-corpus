{
  "package": "@yawlabs/mcp-compliance",
  "tools": [
    {
      "name": "mcp_compliance_test",
      "description": "Run the full MCP compliance test suite against a server URL. Returns grade (A-F), score, and detailed results for all 88 tests covering transport, lifecycle, tools, resources, prompts, errors, schema validation, and security.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The MCP server URL to test (must be HTTP or HTTPS)"
          },
          "auth": {
            "type": "string",
            "description": "Authorization header value (e.g., \"Bearer tok123\")"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Additional headers to include on all requests (e.g., {\"X-Api-Key\": \"abc\"})"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000,
            "description": "Request timeout in milliseconds (default: 15000, max: 300000)"
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Number of retries for failed tests (default: 0, max: 10)"
          },
          "only": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only run tests matching these categories or test IDs"
          },
          "skip": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skip tests matching these categories or test IDs"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "mcp_compliance_badge",
      "description": "Get the badge markdown embed code for an MCP server. Runs the compliance test suite first to determine the grade.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The MCP server URL to test"
          },
          "auth": {
            "type": "string",
            "description": "Authorization header value (e.g., \"Bearer tok123\")"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Additional headers to include on all requests"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000,
            "description": "Request timeout in milliseconds (default: 15000, max: 300000)"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "mcp_compliance_explain",
      "description": "Explain what a specific compliance test ID checks and why it matters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "testId": {
            "type": "string",
            "description": "The test ID to explain (e.g., \"transport-post\", \"lifecycle-init\", \"tools-schema\")"
          }
        },
        "required": [
          "testId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}