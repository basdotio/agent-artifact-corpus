# Keep the build context small and avoid copying local junk into the image.
.git
.github
.gitignore
.dockerignore
README.md
CONTRIBUTING.md
CHANGELOG.md
SECURITY.md
LICENSE

# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
env/
venv/
.venv/

# Tests aren't needed at runtime
tests/

# CTF artifacts / secrets should never enter the image
challenges/
extractions/
extracted/
*.pcap
*.pcapng
*.bin
*.elf
*.exe
.env
.env.*
*.key
*.pem
