# Fatture in Cloud API credentials
# Ottieni da: Fatture in Cloud > Impostazioni > API e Integrazioni > Token Manuale

# Access Token (inizia con a/...)
FIC_ACCESS_TOKEN=a/your_access_token_here

# Company ID (visibile nell'URL quando sei loggato)
FIC_COMPANY_ID=123456

# Email mittente per invio fatture (richiesto per send_email)
FIC_SENDER_EMAIL=fatturazione@tuaazienda.it

# --- Opzionali ---

# Cache locale per anagrafiche e centri di costo (default: ~/.fattureincloud-mcp/cache)
# FIC_CACHE_DIR=~/.fattureincloud-mcp/cache

# Disabilita cache (utile in test / debug)
# FIC_CACHE_DISABLED=1
