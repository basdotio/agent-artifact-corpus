{
  "package": "@fre4x/arxiv",
  "tools": [
    {
      "name": "search_papers",
      "description": "Search arXiv for academic papers using a query.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query with optional arXiv prefixes"
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sort_by": {
            "default": "relevance",
            "description": "Sort field: relevance | lastUpdatedDate | submittedDate",
            "type": "string",
            "enum": [
              "relevance",
              "lastUpdatedDate",
              "submittedDate"
            ]
          },
          "sort_order": {
            "default": "descending",
            "description": "Sort order: ascending | descending",
            "type": "string",
            "enum": [
              "ascending",
              "descending"
            ]
          },
          "response_format": {
            "default": "markdown",
            "description": "Output format: markdown or json",
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ]
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_paper",
      "description": "Retrieve full details for one or more arXiv papers by ID.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ids": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of arXiv paper IDs"
          },
          "response_format": {
            "default": "markdown",
            "description": "Output format: markdown or json",
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ]
          }
        },
        "required": [
          "ids"
        ]
      }
    },
    {
      "name": "search_by_author",
      "description": "Search arXiv for papers by a specific author name.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "author": {
            "type": "string",
            "description": "Author name to search for (e.g. 'Yann LeCun')"
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sort_by": {
            "default": "relevance",
            "description": "Sort field: relevance | lastUpdatedDate | submittedDate",
            "type": "string",
            "enum": [
              "relevance",
              "lastUpdatedDate",
              "submittedDate"
            ]
          },
          "sort_order": {
            "default": "descending",
            "description": "Sort order: ascending | descending",
            "type": "string",
            "enum": [
              "ascending",
              "descending"
            ]
          },
          "response_format": {
            "default": "markdown",
            "description": "Output format: markdown or json",
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ]
          }
        },
        "required": [
          "author"
        ]
      }
    },
    {
      "name": "search_by_category",
      "description": "Browse or search papers within a specific arXiv subject category.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "arXiv category code (e.g. 'cs.AI')"
          },
          "query": {
            "description": "Optional additional search query to filter",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sort_by": {
            "default": "submittedDate",
            "description": "Sort field: relevance | lastUpdatedDate | submittedDate",
            "type": "string",
            "enum": [
              "relevance",
              "lastUpdatedDate",
              "submittedDate"
            ]
          },
          "sort_order": {
            "default": "descending",
            "description": "Sort order: ascending | descending",
            "type": "string",
            "enum": [
              "ascending",
              "descending"
            ]
          },
          "response_format": {
            "default": "markdown",
            "description": "Output format: markdown or json",
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ]
          }
        },
        "required": [
          "category"
        ]
      }
    },
    {
      "name": "list_categories",
      "description": "List the commonly used arXiv subject categories with their descriptions.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "description": "Maximum results to return (1–100, default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination (default 0)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  ]
}