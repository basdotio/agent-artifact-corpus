{
  "package": "hn-mcp",
  "tools": [
    {
      "name": "browse_stories",
      "description": "Browse Hacker News stories by type. Returns story list with scores, comments, and metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "top",
              "new",
              "best",
              "ask",
              "show",
              "job"
            ],
            "default": "top",
            "description": "Story type: \"top\" (highest voted), \"new\" (most recent), \"best\" (curated best), \"ask\" (Ask HN), \"show\" (Show HN), \"job\" (Who is hiring)"
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 30,
            "description": "Default 30, range (1-100). Change ONLY IF user specifies."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search_hn",
      "description": "Search Hacker News stories and comments. Returns matching content with relevance scores.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search terms (e.g., \"rust async\", \"GPT-4\", \"startup advice\")"
          },
          "tags": {
            "type": "string",
            "enum": [
              "story",
              "comment",
              "ask_hn",
              "show_hn",
              "poll"
            ],
            "description": "Filter by: \"story\" (submissions), \"comment\" (discussions), \"ask_hn\", \"show_hn\", or \"poll\""
          },
          "dateRange": {
            "type": "string",
            "enum": [
              "all",
              "last24h",
              "pastWeek",
              "pastMonth",
              "pastYear"
            ],
            "default": "all",
            "description": "Time filter: \"all\" (any time), \"last24h\", \"pastWeek\", \"pastMonth\", or \"pastYear\""
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "relevance",
              "date"
            ],
            "default": "relevance",
            "description": "Sort results by relevance score or date posted"
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 30,
            "description": "Default 30, range (1-100). Override ONLY IF user requests."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_story_details",
      "description": "Get a Hacker News story with its comments. Fetches full story content and comment threads.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "description": "Story ID from HN URL (e.g., 38765432 from item?id=38765432)"
          },
          "maxComments": {
            "type": "number",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "Default 10, range (1-50). Change ONLY IF user specifies."
          },
          "commentDepth": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "default": 3,
            "description": "Default 3, range (1-5). Change ONLY IF user asks."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "user_analysis",
      "description": "Analyze a Hacker News user's profile, karma, and recent submissions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "HN username (e.g., \"pg\", \"dang\", \"tptacek\")"
          },
          "submissionLimit": {
            "type": "number",
            "minimum": 0,
            "maximum": 50,
            "default": 10,
            "description": "Default 10, range (0-50). Override ONLY IF user requests."
          }
        },
        "required": [
          "username"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "hn_explain",
      "description": "Get explanations of Hacker News terms, culture, and conventions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "description": "HN term or concept (e.g., \"karma\", \"flagged\", \"dupe\", \"Show HN\", \"Ask HN\")"
          }
        },
        "required": [
          "term"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}