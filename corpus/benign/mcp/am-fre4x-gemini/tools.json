{
  "package": "@fre4x/gemini",
  "tools": [
    {
      "name": "analyze_media",
      "description": "Analyze an image or audio file from a URL or file path.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "prompt": {
            "default": "Describe this media.",
            "description": "Optional question or instruction for the media.",
            "type": "string",
            "minLength": 1
          },
          "media_source": {
            "type": "string",
            "minLength": 1,
            "description": "URL, file:// path, or local file path."
          },
          "mime_type": {
            "description": "Optional MIME type override.",
            "type": "string"
          },
          "model": {
            "default": "gemini-2.5-flash",
            "description": "Supported analyze_media model.",
            "type": "string",
            "enum": [
              "gemini-2.5-flash",
              "gemini-2.5-pro",
              "gemini-2.5-flash-lite"
            ]
          },
          "output_dir": {
            "description": "Optional directory to save the analysis result as a .txt file.",
            "type": "string"
          }
        },
        "required": [
          "media_source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_models",
      "description": "List available models for Gemini media tools, including stable and preview catalogs when offered.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "capability": {
            "default": "all",
            "description": "Filter the returned model catalogs by analyze, image, video, or all.",
            "type": "string",
            "enum": [
              "all",
              "analyze",
              "image",
              "video"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "generate_image",
      "description": "Generate an image using Imagen and optionally save it to disk.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Description of the image to generate."
          },
          "aspect_ratio": {
            "default": "1:1",
            "description": "Aspect ratio for the image.",
            "type": "string",
            "enum": [
              "1:1",
              "16:9",
              "9:16"
            ]
          },
          "model": {
            "default": "imagen-4.0-generate-001",
            "description": "Supported generate_image model.",
            "type": "string",
            "enum": [
              "imagen-4.0-generate-001",
              "imagen-4.0-ultra-generate-001",
              "imagen-4.0-fast-generate-001"
            ]
          },
          "output_dir": {
            "description": "Directory to save the image file.",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "generate_video",
      "description": "Start an async video generation request using Veo.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Description of the video to generate."
          },
          "model": {
            "default": "veo-3.1-generate-preview",
            "description": "Supported generate_video model.",
            "type": "string",
            "enum": [
              "veo-3.1-generate-preview",
              "veo-3.1-lite-generate-preview"
            ]
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_video_status",
      "description": "Check the status of a video generation request.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "operation_name": {
            "type": "string",
            "minLength": 1,
            "description": "Operation name returned by generate_video."
          },
          "output_dir": {
            "description": "Directory to save the completed video file.",
            "type": "string"
          }
        },
        "required": [
          "operation_name"
        ],
        "additionalProperties": false
      }
    }
  ]
}