"""End-to-end tests: they launch the real server and speak real MCP to it."""

from __future__ import annotations

import os
import sys
from pathlib import Path

import pytest

from mcp_forge.client import StdioClient

SERVER = str(Path(__file__).resolve().parent.parent / "server.py")


@pytest.fixture()
def client(tmp_path: Path):
    (tmp_path / "hello.txt").write_text("line one\nline two\n", encoding="utf-8")
    env = dict(os.environ, MCP_ROOT=str(tmp_path), PYTHONIOENCODING="utf-8")
    with StdioClient([sys.executable, SERVER], env=env) as session:
        session.initialize()
        yield session


def test_handshake_declares_tools(client):
    names = {tool["name"] for tool in client.list_tools()}
    assert {"now", "list_files", "read_text"} <= names


def test_list_files_sees_the_fixture(client):
    result = client.call_tool("list_files", {"directory": "."})
    assert result["isError"] is False
    assert "hello.txt" in result["content"][0]["text"]


def test_read_text_returns_the_content(client):
    result = client.call_tool("read_text", {"path": "hello.txt"})
    assert "line one" in result["content"][0]["text"]


def test_missing_required_argument_is_rejected(client):
    raw = client.send_raw({"jsonrpc": "2.0", "id": 99, "method": "tools/call",
                           "params": {"name": "read_text", "arguments": {}}})
    assert raw["error"]["code"] == -32602


def test_path_traversal_is_blocked(client):
    result = client.call_tool("read_text", {"path": "../../etc/passwd"})
    assert result["isError"] is True
