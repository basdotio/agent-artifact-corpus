{
  "package": "agentmail-mcp",
  "tools": [
    {
      "name": "list_inboxes",
      "description": "List inboxes",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 10,
            "description": "Max number of items to return",
            "type": "number"
          },
          "pageToken": {
            "description": "Page token for pagination",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_inbox",
      "description": "Get inbox",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "inboxId": {
            "type": "string",
            "description": "ID of inbox"
          }
        },
        "required": [
          "inboxId"
        ]
      }
    },
    {
      "name": "create_inbox",
      "description": "Create inbox",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "username": {
            "description": "Username",
            "type": "string"
          },
          "domain": {
            "description": "Domain",
            "type": "string"
          },
          "displayName": {
            "description": "Display name",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "delete_inbox",
      "description": "Delete inbox",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "inboxId": {
            "type": "string",
            "description": "ID of inbox"
          }
        },
        "required": [
          "inboxId"
        ]
      }
    },
    {
      "name": "list_threads",
      "description": "List threads in inbox",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 10,
            "description": "Max number of items to return",
            "type": "number"
          },
          "pageToken": {
            "description": "Page token for pagination",
            "type": "string"
          },
          "inboxId": {
            "type": "string",
            "description": "ID of inbox"
          },
          "labels": {
            "description": "Labels to filter items by",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "before": {
            "description": "Filter items before datetime",
            "type": "string"
          },
          "after": {
            "description": "Filter items after datetime",
            "type": "string"
          }
        },
        "required": [
          "inboxId"
        ]
      }
    },
    {
      "name": "get_thread",
      "description": "Get thread",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "inboxId": {
            "type": "string",
            "description": "ID of inbox"
          },
          "threadId": {
            "type": "string",
            "description": "ID of thread"
          }
        },
        "required": [
          "inboxId",
          "threadId"
        ]
      }
    },
    {
      "name": "get_attachment",
      "description": "Get attachment",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "inboxId": {
            "type": "string",
            "description": "ID of inbox"
          },
          "threadId": {
            "type": "string",
            "description": "ID of thread"
          },
          "attachmentId": {
            "type": "string",
            "description": "ID of attachment"
          }
        },
        "required": [
          "inboxId",
          "threadId",
          "attachmentId"
        ]
      }
    },
    {
      "name": "send_message",
      "description": "Send message",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "inboxId": {
            "type": "string",
            "description": "ID of inbox"
          },
          "text": {
            "description": "Plain text body",
            "type": "string"
          },
          "html": {
            "description": "HTML body",
            "type": "string"
          },
          "labels": {
            "description": "Labels",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attachments": {
            "description": "Attachments",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "description": "Filename",
                  "type": "string"
                },
                "content_id": {
                  "description": "Content ID for inline attachments",
                  "type": "string"
                },
                "content": {
                  "description": "Base64 encoded content",
                  "type": "string"
                },
                "url": {
                  "description": "URL",
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Recipients"
          },
          "cc": {
            "description": "CC recipients",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bcc": {
            "description": "BCC recipients",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "description": "Subject",
            "type": "string"
          }
        },
        "required": [
          "inboxId",
          "to"
        ]
      }
    },
    {
      "name": "reply_to_message",
      "description": "Reply to message",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "inboxId": {
            "type": "string",
            "description": "ID of inbox"
          },
          "text": {
            "description": "Plain text body",
            "type": "string"
          },
          "html": {
            "description": "HTML body",
            "type": "string"
          },
          "labels": {
            "description": "Labels",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attachments": {
            "description": "Attachments",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "description": "Filename",
                  "type": "string"
                },
                "content_id": {
                  "description": "Content ID for inline attachments",
                  "type": "string"
                },
                "content": {
                  "description": "Base64 encoded content",
                  "type": "string"
                },
                "url": {
                  "description": "URL",
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "messageId": {
            "type": "string",
            "description": "ID of message"
          },
          "replyAll": {
            "description": "Reply to all recipients",
            "type": "boolean"
          }
        },
        "required": [
          "inboxId",
          "messageId"
        ]
      }
    },
