{
  "model": "gpt-5-codex",
  "stream": true,
  "store": false,
  "instructions": "You are Codex, a coding agent running in a terminal.",
  "input": [
    {
      "type": "message",
      "role": "user",
      "content": [
        { "type": "input_text", "text": "Fix the failing test in src/util.ts and run the suite." }
      ]
    },
    {
      "type": "message",
      "role": "assistant",
      "content": [{ "type": "output_text", "text": "I'll read the file first." }]
    },
    {
      "type": "function_call",
      "id": "fc_001",
      "call_id": "call_abc123",
      "name": "shell",
      "arguments": "{\"command\":[\"cat\",\"src/util.ts\"]}"
    },
    {
      "type": "function_call_output",
      "call_id": "call_abc123",
      "output": "export function add(a: number, b: number) { return a - b; }"
    }
  ],
  "tools": [
    {
      "type": "function",
      "name": "shell",
      "description": "Run a shell command and return its output.",
      "parameters": {
        "type": "object",
        "properties": { "command": { "type": "array", "items": { "type": "string" } } },
        "required": ["command"]
      }
    },
    {
      "type": "function",
      "name": "apply_patch",
      "description": "Apply a patch to files in the workspace.",
      "parameters": {
        "type": "object",
        "properties": { "input": { "type": "string" } },
        "required": ["input"]
      }
    },
    {
      "type": "function",
      "name": "update_plan",
      "description": "Update the task plan shown to the user.",
      "parameters": {
        "type": "object",
        "properties": { "plan": { "type": "array", "items": { "type": "string" } } },
        "required": ["plan"]
      }
    }
  ]
}
