{
  "package": "@morningljn/mnemo",
  "tools": [
    {
      "name": "fact_store",
      "description": "结构化事实记忆系统（SQLite+FTS5 索引）。支持读写。\n\n操作：\n- search — 关键词查找\n- probe — 实体探测：关于某人/某事的所有事实\n- related — 实体关联\n- reason — 组合推理：同时关联多个实体的事实\n- contradict — 矛盾检测\n- list — 浏览事实\n- add — 添加新事实（自动去重，相似则更新，单条 ≤300 字）\n- update — 更新已有事实\n- remove — 删除事实\n- auto_observe — 自动保存工作流/偏好记忆（AI 完成任务后调用，trust=0.3 起步）\n- cleanup — 扫描超长 fact 报告\n\n写入时先 search 检查是否已存在相似事实。单条 content 不超过 300 字，聚焦一个主题。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "add",
              "search",
              "probe",
              "related",
              "reason",
              "contradict",
              "update",
              "remove",
              "list",
              "learn",
              "audit",
              "dream",
              "cleanup",
              "auto_observe"
            ]
          },
          "content": {
            "description": "事实内容（'add' 必需，支持批量）",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "summary": {
            "description": "超长事实的摘要（检索用 summary 匹配）",
            "type": "string"
          },
          "query": {
            "description": "搜索查询（'search' 必需）",
            "type": "string"
          },
          "entity": {
            "description": "实体名（'probe'/'related' 使用）",
            "type": "string"
          },
          "entities": {
            "description": "实体列表（'reason' 使用）",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fact_id": {
            "description": "事实 ID（'update'/'remove' 使用，支持批量）",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "identity",
              "coding_style",
              "tool_pref",
              "workflow",
              "general"
            ]
          },
          "tags": {
            "description": "逗号分隔标签",
            "type": "string"
          },
          "trust_delta": {
            "description": "'update' 的信任调整值",
            "type": "number"
          },
          "min_trust": {
            "description": "最低信任过滤（默认 0.3）",
            "type": "number"
          },
          "limit": {
            "description": "最大结果数（默认 10）",
            "type": "number"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "fact_feedback",
      "description": "使用事实后评分。标记 helpful 如果准确，unhelpful 如果过时。训练记忆系统 — 好事实上升，坏事实下降。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "helpful",
              "unhelpful"
            ]
          },
          "fact_id": {
            "type": "number",
            "description": "要评分的事实 ID"
          }
        },
        "required": [
          "action",
          "fact_id"
        ]
      }
    }
  ]
}