# Set these in your MCP client's "env" block or export them in your shell.
# The server does not read a .env file itself.
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# Optional: path to a JSON config file used when the variables above are unset.
# TRELLO_CONFIG=~/.config/trello-mcp/config.json
